[package]
name = "dig"
version = "${file:VERSION}"
description = "dig — DNS resolver (sovereign Cyrius reimplementation of BIND dig)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.6.20"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "dig"

[deps]
# "flags" was declared at 0.3.0 for "CLI parsing" and never referenced by a
# single line of dig — cli.cyr was hand-rolled precisely because lib/flags.cyr's
# --long grammar does not fit BIND's `@server` / `+flag` shape. Dropped at 0.3.7
# when [deps.cmdit] took over the getopt-shaped surface, same move kii made at
# its v1.1.0. "args" stays: cmdit_argv / cmdit_parse call args_init/argc/argv.
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "args"]

# Network-probe substrate — the IPv4 codec dig shared byte-identically
# with yo, extracted at the 0.3.3 / yo-0.5.5 fold. dig consumes taar only
# for that `ipv4_*` codec; the bundle's `socket`/`dns` modules ride along
# unreachable (DCE-eliminable). 0.5.0 grew DNS-over-TCP (TC fallback) and
# the AGNOS recv-timeout/close split — both on taar's own DNS path, which
# dig does not call, so its surface here is unchanged from 0.3.1.
#
# `path = "../<dep>"` is commented out on both deps (0.4.2). It wins over
# `tag` whenever the sibling checkout exists, so a local build vendored the
# sibling's *working tree*: through 0.4.1 that was cmdit 1.2.5 / 1.4.0 and
# taar 0.5.1 while this file said 1.2.4 / 0.5.0, and today it would be
# cmdit 1.5.1 / taar 0.6.2 (both pinned to cyrius 6.7.18). With it off, the
# local build resolves the same `git`+`tag` CI does. Uncomment it only for
# deliberate co-development against an unreleased sibling.
# CLI substrate. dig's grammar is BIND's, not getopt-long — `@server` and
# `+flag` are hand-tokenized in src/cli.cyr and stay that way; cmdit's own docs
# name dig as the case its `cmdit_raw_argv` escape hatch exists for. What cmdit
# owns here is everything AROUND the tokenizer: --help/-h, --version/-V (which
# dig simply did not have before 0.3.7), and the 0/1/2 exit convention as named
# constants. That kills the hand-written-help drift class rather than any
# parsing work.
[deps.cmdit]
git = "https://github.com/MacCracken/cmdit.git"
# path = "../cmdit"
tag = "1.2.6"
modules = ["dist/cmdit.cyr"]

[deps.taar]
git = "https://github.com/MacCracken/taar.git"
# path = "../taar"
tag = "0.5.2"
modules = ["dist/taar.cyr"]
---
