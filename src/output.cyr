# output.cyr — BIND-shape result printing.
#
# Two modes:
#   Default: full BIND output —
#       ; <<>> dig X.Y.Z <<>> name
#       ;; QUESTION
#       ;name.        IN    A
#       ;; ANSWER
#       name.   3600  IN    A    93.184.216.34
#       ;; Query time: N ms · server: X · proto: udp
#
#   +short: bare answer values, one per line.
#
# Per-type formatting lives in `output_print_rdata` so adding a new
# RR type is a single switch arm.

# Banner version. Derived from `[package].version` (itself `${file:VERSION}`)
# via the compiler-injected `CYRIUS_PKG_VERSION` constant — hand-maintained
# until 0.3.6, where it had silently reported 0.3.3 for two releases.
# Requires cyrius >= 6.5.34: the constant resolved only in the entry file
# before that, and output.cyr is included by main.cyr, not the entry.
var _DIG_VERSION_STR = CYRIUS_PKG_VERSION;

fn _out_puts(s): i64 { sys_write(1, s, strlen(s)); return 0; }
fn _out_eputs(s): i64 { sys_write(2, s, strlen(s)); return 0; }

# RFC 1035 §5.1 presentation escaping into a caller buffer. Returns bytes
# written, or -1 if the result would not fit `dst_cap` (refuses, never truncates).
#
# EVERY byte that reaches stdout from a DNS response goes through here. Labels
# and TXT character-strings are arbitrary octet runs on the wire — the RFC
# constrains their LENGTH, not their content — so before 0.3.7 a response could
# put raw control bytes on the user's terminal. Demonstrated, not theorised: a
# TXT record carrying CR + ESC [ 2 K erases the line dig just printed and
# repaints whatever it likes, and needs no spoofing at all, only a zone the
# attacker controls. An embedded 0x0A forges an extra line in `+short`, the form
# scripts read with `for ip in $(dig +short ...)`. An embedded NUL used to
# truncate the whole name at the first one, because the sink was strlen-based.
#
# Length-driven, never strlen — see dns_decode_name's `out_len`.
#
# `esc_space` selects context. A bare space is ambiguous in an unquoted name, so
# names pass 1 and get `\032` (what BIND prints). TXT is already delimited by
# quotes and passes 0 — escaping there would render the near-universal
# `v=spf1 -all` as `v=spf1\032-all` for no benefit. Control bytes are escaped in
# BOTH contexts; that is the security-relevant half and it is not configurable.
#
# KNOWN LIMIT: a literal 0x2E inside a label is NOT escaped as `\.`, because
# dns_decode_name flattens labels into a dotted string and by the time bytes
# reach here a separator dot and an in-label dot are indistinguishable. A
# BIND-fidelity gap with no security consequence; closing it needs the
# decoder-side rewrite parked at 0.4.x.
fn _esc_to_buf(dst, dst_cap, src, n, esc_space): i64 {
    var o = 0;
    var i = 0;
    while (i < n) {
        var c = load8(src + i);
        var esc = 0;
        if (c == 92)       { esc = 1; }
        elif (c == 34)     { esc = 2; }
        elif (c == 32)     { if (esc_space == 1) { esc = 3; } }
        elif (c < 32)      { esc = 3; }
        elif (c > 126)     { esc = 3; }
        if (esc == 1) {
            if (o + 2 > dst_cap) { return 0 - 1; }
            store8(dst + o, 92); store8(dst + o + 1, 92);
            o = o + 2;
        } elif (esc == 2) {
            if (o + 2 > dst_cap) { return 0 - 1; }
            store8(dst + o, 92); store8(dst + o + 1, 34);
            o = o + 2;
        } elif (esc == 3) {
            if (o + 4 > dst_cap) { return 0 - 1; }
            store8(dst + o,     92);
            store8(dst + o + 1, 48 + ((c / 100) % 10));
            store8(dst + o + 2, 48 + ((c / 10) % 10));
            store8(dst + o + 3, 48 + (c % 10));
            o = o + 4;
        } else {
            if (o + 1 > dst_cap) { return 0 - 1; }
            store8(dst + o, c);
            o = o + 1;
        }
        i = i + 1;
    }
    return o;
}

# Write `n` bytes to stdout with the escaping above. Callers pass at most
# DNS_MAX_NAME_LEN (255) bytes — a name, or one TXT character-string — and the
# 1024-byte scratch covers the 4x worst case (255 * 4 = 1020) with room to
# spare. An over-long input is refused rather than truncated.
fn _out_escaped(p, n, esc_space): i64 {
    var eb[1024];
    var w = _esc_to_buf(&eb, 1024, p, n, esc_space);
    if (w < 0) { return 0 - 1; }
    sys_write(1, &eb, w);
    return 0;
}

# Type-code → "A" / "AAAA" / "MX" / ... mnemonic. Returns a cstr.
fn output_type_str(t): i64 {
    if (t == DNS_TYPE_A)     { return "A"; }
    if (t == DNS_TYPE_AAAA)  { return "AAAA"; }
    if (t == DNS_TYPE_MX)    { return "MX"; }
    if (t == DNS_TYPE_NS)    { return "NS"; }
    if (t == DNS_TYPE_CNAME) { return "CNAME"; }
    if (t == DNS_TYPE_SOA)   { return "SOA"; }
    if (t == DNS_TYPE_PTR)   { return "PTR"; }
    if (t == DNS_TYPE_TXT)   { return "TXT"; }
    if (t == DNS_TYPE_SRV)   { return "SRV"; }
    if (t == DNS_TYPE_OPT)   { return "OPT"; }
    if (t == DNS_TYPE_DS)    { return "DS"; }
    if (t == DNS_TYPE_RRSIG) { return "RRSIG"; }
    if (t == DNS_TYPE_NSEC)  { return "NSEC"; }
    if (t == DNS_TYPE_DNSKEY){ return "DNSKEY"; }
    if (t == DNS_TYPE_NSEC3) { return "NSEC3"; }
    return 0;
}

# Print the RR-type mnemonic, or RFC 3597 §5's `TYPE<n>`. The old `"TYPE?"`
# fallback threw the code away, leaving output that neither a human nor a script
# can act on — and it is the MORE reachable of the two unknown-type paths, since
# any CAA / SVCB / HTTPS / TLSA record in an answer lands here.
fn output_print_type(t): i64 {
    var m = output_type_str(t);
    if (m != 0) { return _out_puts(m); }
    _out_puts("TYPE");
    fmt_int(t);
    return 0;
}

# RCODE -> mnemonic ("NOERROR", "NXDOMAIN", ...) as a cstr, BIND spelling.
# Unknown codes fall back to a placeholder rather than reading off a table, so
# an attacker-chosen RCODE cannot index out of range.
fn output_rcode_str(r): i64 {
    if (r == DNS_RCODE_NOERROR)  { return "NOERROR"; }
    if (r == DNS_RCODE_FORMERR)  { return "FORMERR"; }
    if (r == DNS_RCODE_SERVFAIL) { return "SERVFAIL"; }
    if (r == DNS_RCODE_NXDOMAIN) { return "NXDOMAIN"; }
    if (r == DNS_RCODE_NOTIMP)   { return "NOTIMP"; }
    if (r == DNS_RCODE_REFUSED)  { return "REFUSED"; }
    if (r == DNS_RCODE_YXDOMAIN) { return "YXDOMAIN"; }
    if (r == DNS_RCODE_YXRRSET)  { return "YXRRSET"; }
    if (r == DNS_RCODE_NXRRSET)  { return "NXRRSET"; }
    if (r == DNS_RCODE_NOTAUTH)  { return "NOTAUTH"; }
    if (r == DNS_RCODE_NOTZONE)  { return "NOTZONE"; }
    return 0;
}

# Print the RCODE mnemonic, or BIND's `RESERVED<n>` for 11-15. A print-style
# helper rather than a cstr-returning one because the reserved range needs the
# number formatted in. Through 0.3.7 every code above 5 printed a flat
# `RCODE?`, which discards the value the operator needs.
fn output_print_rcode(r): i64 {
    var m = output_rcode_str(r);
    if (m != 0) { return _out_puts(m); }
    _out_puts("RESERVED");
    fmt_int(r);
    return 0;
}

# Print the CLASS mnemonic, or `CLASS<n>` for anything else — never a table
# index, since the class is an attacker-chosen 16-bit value. Omitting CS(2) is
# deliberate: BIND has no entry for it either, so both print `CLASS2`.
fn output_print_class(c): i64 {
    if (c == DNS_CLASS_IN) { return _out_puts("IN"); }
    if (c == 3)            { return _out_puts("CH"); }
    if (c == 4)            { return _out_puts("HS"); }
    _out_puts("CLASS");
    fmt_int(c);
    return 0;
}

# Print one RR's rdata in type-appropriate form. Returns 0 on success,
# negative on parse error.
# Render an AAAA as RFC 5952 §4: leading zeros suppressed, the leftmost longest
# run of >=2 zero groups replaced by `::`, lowercase hex (fmt_hex gives all
# three). Through 0.3.7 this printed eight fixed 4-digit groups, so EVERY
# real-world AAAA differed from BIND, not merely ones with zero runs.
#
# The `use_v4` arm is RFC 5952 §5 as glibc's inet_ntop6 implements it — and
# therefore as BIND inherits it. Without it `::ffff:c000:0201` renders
# `::ffff:c000:201` where BIND prints `::ffff:192.0.2.1`.
#
# Renders into `dst` (needs 64 bytes) and returns the length, so the RFC 5952
# rules above are assertable without capturing stdout. `_out_aaaa` is the thin
# stdout wrapper.
fn _aaaa_to_buf(dst, msg, rdoff): i64 {
    var w[16];
    var i = 0;
    while (i < 8) {
        store16(&w + i * 2, (load8(msg + rdoff + i * 2) << 8) | load8(msg + rdoff + i * 2 + 1));
        i = i + 1;
    }
    # Leftmost longest zero run. Strictly-greater keeps the leftmost on a tie
    # (§4.2.3); a run of one is not eligible (§4.2.2).
    var best_base = 0 - 1;
    var best_len = 0;
    var cur_base = 0 - 1;
    var cur_len = 0;
    i = 0;
    while (i < 8) {
        if (load16(&w + i * 2) == 0) {
            if (cur_base < 0) { cur_base = i; cur_len = 0; }
            cur_len = cur_len + 1;
            if (cur_len > best_len) { best_base = cur_base; best_len = cur_len; }
        } else {
            cur_base = 0 - 1;
            cur_len = 0;
        }
        i = i + 1;
    }
    if (best_len < 2) { best_base = 0 - 1; best_len = 0; }

    var use_v4 = 0;
    if (best_base == 0) {
        if (best_len == 6) { use_v4 = 1; }
        if (best_len == 7) { if (load16(&w + 14) != 1) { use_v4 = 1; } }
        if (best_len == 5) { if (load16(&w + 10) == 0xFFFF) { use_v4 = 1; } }
    }

    var o = 0;
    i = 0;
    while (i < 8) {
        var in_run = 0;
        if (best_base >= 0) {
            if (i >= best_base) { if (i < best_base + best_len) { in_run = 1; } }
        }
        if (in_run == 1) {
            if (i == best_base) { store8(dst + o, 58); o = o + 1; }
        } else {
            if (i != 0) { store8(dst + o, 58); o = o + 1; }
            if ((use_v4 == 1) && (i == 6)) {
                var packed = (load8(msg + rdoff + 12) << 24)
                | (load8(msg + rdoff + 13) << 16)
                | (load8(msg + rdoff + 14) << 8)
                |  load8(msg + rdoff + 15);
                o = o + ipv4_format_to_buf(packed, dst + o);
                i = 8;
            } else {
                o = o + fmt_hex_buf(load16(&w + i * 2), dst + o);
            }
        }
        i = i + 1;
    }
    if (best_base >= 0) {
        if (best_base + best_len == 8) { store8(dst + o, 58); o = o + 1; }
    }
    store8(dst + o, 0);
    return o;
}

fn _out_aaaa(msg, rdoff): i64 {
    var b[64];
    var n = _aaaa_to_buf(&b, msg, rdoff);
    sys_write(1, &b, n);
    return 0;
}

# Render an unhandled RR type per RFC 3597 §5: `\# <rdlength> <hex>`.
#
# Through 0.3.7 this was a bare `fmt_hex` per byte, and fmt_hex is
# VARIABLE-width — so distinct rdata collided: {00 01 0a 05}, {00 1a 05} and
# {00 01 a5} all rendered `01a5`. The same file was already doing this correctly
# for AAAA with the fixed-width fmt_byte. The `\# len` prefix makes the length
# explicit and kills cross-length collisions outright.
fn output_print_rdata_unknown(msg, rdoff, rdlen): i64 {
    _out_puts("\\# ");
    fmt_int(rdlen);
    var i2 = 0;
    while (i2 < rdlen) {
        if (i2 == 0) { _out_puts(" "); }
        fmt_byte(load8(msg + rdoff + i2));
        i2 = i2 + 1;
    }
    return 0;
}

# Print one RR's rdata. Returns 0, or -1 if the rdata is malformed for its type.
#
# TWO INVARIANTS, both added at 0.3.8 after the audit, both load-bearing:
#
#  1. VALIDATE BEFORE EMITTING. Every arm now completes its checks before the
#     first byte goes out. MX, SRV and SOA used to write their fixed fields (and
#     for SOA both names) and only then discover the rdata was short, leaving a
#     half-rendered record on stdout followed by a -1 nobody read.
#
#  2. NAMES ARE BOUNDED BY RDLENGTH, NOT msg_len. dns_parse_rr guarantees
#     rdata+rdlen <= msg_len, so decoding against msg_len was memory-SAFE — but
#     it read the name out of the NEXT record's bytes and printed it as this
#     record's authoritative content, returning success. Measured: an NS with
#     rdlen=0 rendered a neighbouring name at rc=0. The check is `!=`, not `<=`:
#     BIND treats unconsumed trailing rdata as FORMERR too, and every legal
#     encoding (uncompressed, fully compressed, partially compressed) lands
#     exactly on rdoff+rdlen.
#
#     Note we do NOT pass rdoff+rdlen as dns_decode_name's msg_len — compression
#     pointers legitimately target earlier bytes outside this rdata (RFC 1035
#     §4.1.4) and the decoder uses the same limit for both. The end-offset
#     post-check is the correct predicate and leaves the decoder untouched.
fn output_print_rdata(msg, msg_len, rr, next_off): i64 {
    var t = dns_rr_type(rr);
    var rdoff = dns_rr_rdata_off(rr);
    var rdlen = next_off - rdoff;
    var rdend = rdoff + rdlen;

    if (t == DNS_TYPE_A) {
        if (rdlen != 4) { return 0 - 1; }
        var buf[16];
        var packed = (load8(msg + rdoff) << 24)
        | (load8(msg + rdoff + 1) << 16)
        | (load8(msg + rdoff + 2) << 8)
        |  load8(msg + rdoff + 3);
        var n = ipv4_format_to_buf(packed, &buf);
        sys_write(1, &buf, n);
        return 0;
    }
    if (t == DNS_TYPE_AAAA) {
        if (rdlen != 16) { return 0 - 1; }
        return _out_aaaa(msg, rdoff);
    }
    if (t == DNS_TYPE_MX) {
        if (rdlen < 3) { return 0 - 1; }
        var nbuf[DNS_NAME_BUF_LEN];
        var nl0[8];
        var nend = dns_decode_name(msg, msg_len, rdoff + 2, &nbuf, &nl0);
        if (nend == 0) { return 0 - 1; }
        if (nend != rdend) { return 0 - 1; }
        fmt_int(_dns_load_u16(msg, rdoff));
        _out_puts(" ");
        _out_escaped(&nbuf, load64(&nl0), 1);
        _out_puts(".");
        return 0;
    }
    if (t == DNS_TYPE_NS) {
        var nb1[DNS_NAME_BUF_LEN];
        var nl1[8];
        var ne1 = dns_decode_name(msg, msg_len, rdoff, &nb1, &nl1);
        if (ne1 == 0) { return 0 - 1; }
        if (ne1 != rdend) { return 0 - 1; }
        _out_escaped(&nb1, load64(&nl1), 1);
        _out_puts(".");
        return 0;
    }
    if (t == DNS_TYPE_CNAME) {
        var nb2[DNS_NAME_BUF_LEN];
        var nl2[8];
        var ne2 = dns_decode_name(msg, msg_len, rdoff, &nb2, &nl2);
        if (ne2 == 0) { return 0 - 1; }
        if (ne2 != rdend) { return 0 - 1; }
        _out_escaped(&nb2, load64(&nl2), 1);
        _out_puts(".");
        return 0;
    }
    if (t == DNS_TYPE_PTR) {
        var nb3[DNS_NAME_BUF_LEN];
        var nl3[8];
        var ne3 = dns_decode_name(msg, msg_len, rdoff, &nb3, &nl3);
        if (ne3 == 0) { return 0 - 1; }
        if (ne3 != rdend) { return 0 - 1; }
        _out_escaped(&nb3, load64(&nl3), 1);
        _out_puts(".");
        return 0;
    }
    if (t == DNS_TYPE_TXT) {
        # Two passes. TXT cannot be reordered into validate-then-emit in one
        # sweep, because each segment is only discoverable by walking the one
        # before it — so a later overrun used to land after earlier segments had
        # already been printed. Walk the whole length-prefix chain first.
        var vp = rdoff;
        while (vp < rdend) {
            var vl = load8(msg + vp);
            if (vp + 1 + vl > rdend) { return 0 - 1; }
            vp = vp + 1 + vl;
        }
        if (vp != rdend) { return 0 - 1; }
        var p = rdoff;
        var first = 1;
        while (p < rdend) {
            var l = load8(msg + p);
            if (first == 0) { _out_puts(" "); }
            _out_puts("\"");
            if (l > 0) { _out_escaped(msg + p + 1, l, 0); }
            _out_puts("\"");
            p = p + 1 + l;
            first = 0;
        }
        return 0;
    }
    if (t == DNS_TYPE_SOA) {
        var nb4[DNS_NAME_BUF_LEN];
        var nl4[8];
        var ne4 = dns_decode_name(msg, msg_len, rdoff, &nb4, &nl4);
        if (ne4 == 0) { return 0 - 1; }
        var nb5[DNS_NAME_BUF_LEN];
        var nl5[8];
        var ne5 = dns_decode_name(msg, msg_len, ne4, &nb5, &nl5);
        if (ne5 == 0) { return 0 - 1; }
        if (ne5 + 20 != rdend) { return 0 - 1; }
        _out_escaped(&nb4, load64(&nl4), 1); _out_puts(". ");
        _out_escaped(&nb5, load64(&nl5), 1); _out_puts(". ");
        fmt_int(_dns_load_u32(msg, ne5));       _out_puts(" ");
        fmt_int(_dns_load_u32(msg, ne5 + 4));   _out_puts(" ");
        fmt_int(_dns_load_u32(msg, ne5 + 8));   _out_puts(" ");
        fmt_int(_dns_load_u32(msg, ne5 + 12));  _out_puts(" ");
        fmt_int(_dns_load_u32(msg, ne5 + 16));
        return 0;
    }
    if (t == DNS_TYPE_SRV) {
        if (rdlen < 7) { return 0 - 1; }
        var nb6[DNS_NAME_BUF_LEN];
        var nl6[8];
        var ne6 = dns_decode_name(msg, msg_len, rdoff + 6, &nb6, &nl6);
        if (ne6 == 0) { return 0 - 1; }
        if (ne6 != rdend) { return 0 - 1; }
        fmt_int(_dns_load_u16(msg, rdoff));     _out_puts(" ");
        fmt_int(_dns_load_u16(msg, rdoff + 2)); _out_puts(" ");
        fmt_int(_dns_load_u16(msg, rdoff + 4)); _out_puts(" ");
        _out_escaped(&nb6, load64(&nl6), 1);
        _out_puts(".");
        return 0;
    }
    return output_print_rdata_unknown(msg, rdoff, rdlen);
}

# Print the BIND-shape header (`; <<>> dig X.Y.Z <<>> name`).
fn output_print_header(name): i64 {
    _out_puts("; <<>> dig ");
    _out_puts(_DIG_VERSION_STR);
    _out_puts(" <<>> ");
    _out_puts(name);
    _out_puts("\n");
    return 0;
}

# Print the QUESTION section line (BIND shape).
fn output_print_question(name, qtype): i64 {
    _out_puts(";; QUESTION\n;");
    _out_puts(name);
    # `dig example.com.` used to print `;example.com..` — the name already ends
    # absolute, so appending another dot doubled it. The wire query was always
    # correct (dns_encode_name absorbs the trailing dot); this was display only.
    # `name` is never empty: cli.cyr skips zero-length tokens.
    var nlen = strlen(name);
    if (load8(name + nlen - 1) != 46) { _out_puts("."); }
    # dig only ever sends QCLASS=IN (dns.cyr), so this literal is truthful by
    # construction — unlike the answer line's, which had to start reading the
    # reply's own class.
    _out_puts("\t\tIN\t");
    output_print_type(qtype);
    _out_puts("\n");
    return 0;
}

# Print one ANSWER RR line: `name. ttl IN TYPE rdata`.
fn output_print_answer_rr(msg, msg_len, rr, next_off): i64 {
    var nbuf[DNS_NAME_BUF_LEN];
    var nl7[8];
    var ne = dns_decode_name(msg, msg_len, dns_rr_name_off(rr), &nbuf, &nl7);
    if (ne == 0) { return 0 - 1; }
    _out_escaped(&nbuf, load64(&nl7), 1);
    _out_puts(".\t");
    fmt_int(dns_rr_ttl(rr));
    _out_puts("\t");
    # The reply's OWN class, not a hardcoded "IN". dns_rr_class has been
    # populated since 0.3.0 and read by no production code, so a reply whose
    # answer RR carried CLASS=CH was displayed as IN.
    output_print_class(dns_rr_class(rr));
    _out_puts("\t");
    output_print_type(dns_rr_type(rr));
    _out_puts("\t");
    var r2 = output_print_rdata(msg, msg_len, rr, next_off);
    if (r2 < 0) { _out_eputs(";; WARNING: malformed rdata\n"); }
    _out_puts("\n");
    return r2;
}

# +short mode: rdata only, one per line. Newline appended.
fn output_print_short_rr(msg, msg_len, rr, next_off): i64 {
    var r = output_print_rdata(msg, msg_len, rr, next_off);
    if (r < 0) {
        # stderr, never stdout: a marker on stdout would corrupt the very
        # +short stream scripts parse. Through 0.3.7 this return was discarded
        # and the newline printed regardless, so a malformed A record emitted a
        # BARE BLANK LINE and exit 0 — `ip=$(dig +short host)` yielded "" and
        # the caller was told it had succeeded.
        _out_eputs(";; WARNING: malformed rdata\n");
    }
    _out_puts("\n");
    return r;
}

# Footer line: `;; Query time: N ms · server: A.B.C.D · proto: udp`.
fn output_print_footer(query_us, server_addr, tcp_used): i64 {
    # Decide the proto label BEFORE touching the address buffer.
    #
    # Not style: with `var buf[16]` declared first, the compiler placed it
    # overlapping this parameter's stack slot, and `ipv4_format_to_buf` writing
    # "8.8.8.8" into it left `tcp_used` as 0x3800000000000001 — its low byte
    # still 1, byte 7 replaced by the ASCII '8'. So `tcp_used == 1` was false
    # and every TCP query reported `proto: udp`. Reading the parameter into a
    # local first sidesteps it; a minimal reproduction has NOT been isolated
    # yet, so this is a workaround with a known symptom, not a diagnosis.
    # Filed for cyrius in roadmap.md § upstream.
    var proto = "udp";
    if (tcp_used == 1) { proto = "tcp"; }

    _out_puts(";; Query time: ");
    fmt_int((query_us + 500) / 1000);   # us → ms, half-up
    _out_puts(" ms · server: ");
    var buf[16];
    var n = ipv4_format_to_buf(server_addr, &buf);
    sys_write(1, &buf, n);
    _out_puts(" · proto: ");
    _out_puts(proto);
    _out_puts("\n");
    return 0;
}
