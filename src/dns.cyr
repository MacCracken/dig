# dns.cyr — RFC 1035 DNS framing.
#
# Pure code. No syscalls. No kernel coupling. Caller hands us byte
# buffers; we turn them into wire-format queries and back into parsed
# answer records.
#
# Wire layout (RFC 1035 §4.1, all big-endian):
#
#   Header (12 bytes):
#     +0   ID         u16    random per-query
#     +2   FLAGS      u16    QR|Opcode|AA|TC|RD | RA|Z|RCODE
#     +4   QDCOUNT    u16    # question records
#     +6   ANCOUNT    u16    # answer records
#     +8   NSCOUNT    u16    # authority records
#     +10  ARCOUNT    u16    # additional records
#
#   Question section: <name> qtype:u16 qclass:u16
#   Resource record:  <name> type:u16 class:u16 ttl:u32 rdlength:u16 rdata:rdlength
#
#   Names are sequences of length-prefixed labels terminated by a zero
#   byte. RFC 1035 §4.1.4 lets any label slot be a "pointer" — the high
#   two bits set (0xC0) and a 14-bit offset back into the message.
#   Pointers can chain; a malicious response can craft a loop. We guard
#   with a hop budget (NAME_DECODE_MAX_HOPS).

# === Record type codes ===
var DNS_TYPE_A     = 1;
var DNS_TYPE_NS    = 2;
var DNS_TYPE_CNAME = 5;
var DNS_TYPE_SOA   = 6;
var DNS_TYPE_PTR   = 12;
var DNS_TYPE_MX    = 15;
var DNS_TYPE_TXT   = 16;
var DNS_TYPE_AAAA  = 28;
var DNS_TYPE_SRV   = 33;
var DNS_TYPE_OPT   = 41;
var DNS_TYPE_DS    = 43;
var DNS_TYPE_RRSIG = 46;
var DNS_TYPE_NSEC  = 47;
var DNS_TYPE_DNSKEY = 48;
var DNS_TYPE_NSEC3 = 50;

var DNS_CLASS_IN = 1;

# === Header flag bits (in the FLAGS u16) ===
var DNS_FLAG_QR = 0x8000;   # set on responses
var DNS_FLAG_RD = 0x0100;   # recursion desired
var DNS_FLAG_TC = 0x0200;   # truncated — caller should retry over TCP

# === RCODEs (low 4 bits of FLAGS) ===
var DNS_RCODE_NOERROR  = 0;
var DNS_RCODE_FORMERR  = 1;
var DNS_RCODE_SERVFAIL = 2;
var DNS_RCODE_NXDOMAIN = 3;
var DNS_RCODE_NOTIMP   = 4;
var DNS_RCODE_REFUSED  = 5;
var DNS_RCODE_YXDOMAIN = 6;
var DNS_RCODE_YXRRSET  = 7;
var DNS_RCODE_NXRRSET  = 8;
var DNS_RCODE_NOTAUTH  = 9;
var DNS_RCODE_NOTZONE  = 10;
# 16 (BADVERS) is deliberately absent: dns_hdr_rcode masks to 4 bits, and the
# extended RCODE lives in the OPT pseudo-RR's TTL high byte, which dig does not
# parse until 0.4.x. An arm for it here would be unreachable.

# === Limits ===
var DNS_HEADER_LEN          = 12;
var DNS_MAX_LABEL_LEN       = 63;     # RFC 1035 §2.3.4
var DNS_MAX_NAME_LEN        = 255;    # RFC 1035 §2.3.4

# Buffer size every dns_decode_name output must have. The contract is a
# ZERO-MARGIN exact fit — the terminating NUL lands on index 255 of a 256-byte
# buffer — and through 0.3.7 that was stated only in prose next to thirteen
# hand-written `var nbuf[256]`. An enum with a literal initializer is required
# here: cyrius will not take an expression as an array size, so the derivation
# from DNS_MAX_NAME_LEN cannot be written down. `tests/dig.tcyr` therefore
# asserts the two agree — that assertion is the only thing coupling them.
enum DnsNameBuf { DNS_NAME_BUF_LEN = 256; }
var DNS_MAX_UDP_PAYLOAD     = 512;    # RFC 1035 §2.3.4 (no EDNS yet)
var NAME_DECODE_MAX_HOPS    = 32;     # cycle-detection budget

# Encode a domain name (`example.com\0`) into wire-format qname at
# `out`. Each dot-separated label becomes <len><bytes>; the encoding
# terminates with a zero byte. Returns bytes written, or 0 on any
# violation (label > 63, total > 255, trailing dot syntax error).
fn dns_encode_name(name, out): i64 {
    # The root zone. `dig . NS` is the canonical way to fetch root hints, and
    # through 0.3.7 it died in the empty-label check below: encode returned 0,
    # query.cyr mapped that to QRY_BAD, and main printed
    # `dig: malformed response` and exited 9 — blaming the resolver for an
    # argv-shaped input, having never sent a packet.
    #
    # Keyed on the WHOLE name being ".", not on position. A guard like
    # `src == 0` would make `.example.com` encode as the root and silently query
    # something entirely different, which is strictly worse than refusing it.
    # The empty-label rejection below stays exactly as it is.
    if (load8(name) == 46) {
        if (load8(name + 1) == 0) {
            store8(out, 0);
            return 1;
        }
    }
    var src = 0;
    var dst = 0;
    var label_start = dst;
    store8(out + dst, 0);
    dst = dst + 1;
    while (1) {
        var c = load8(name + src);
        if (c == 0) {
            # End of name. If the last label had content, finalize it.
            if (dst - label_start == 1) {
                # No trailing label content — we just wrote the
                # length byte. The root label is the terminator; we
                # already have it as zero. Done.
                return dst;
            }
            # Patch the length of the in-progress label.
            var llen = dst - label_start - 1;
            if (llen > DNS_MAX_LABEL_LEN) { return 0; }
            store8(out + label_start, llen);
            # Append the root-label terminator.
            store8(out + dst, 0);
            dst = dst + 1;
            if (dst > DNS_MAX_NAME_LEN) { return 0; }
            return dst;
        }
        if (c == 46) {     # '.'
            var llen2 = dst - label_start - 1;
            if (llen2 == 0) { return 0; }              # empty label
            if (llen2 > DNS_MAX_LABEL_LEN) { return 0; }
            store8(out + label_start, llen2);
            label_start = dst;
            store8(out + dst, 0);
            dst = dst + 1;
        } else {
            store8(out + dst, c);
            dst = dst + 1;
        }
        if (dst > DNS_MAX_NAME_LEN) { return 0; }
        src = src + 1;
    }
    return 0;
}

# Decode a wire-format qname starting at offset `off` within `msg`
# (total `msg_len` bytes). Writes a dotted ASCII representation to
# `out` (null-terminated), out must hold at least DNS_MAX_NAME_LEN+1
# bytes, and stores the decoded BYTE LENGTH through `out_len`.
#
# `out_len` exists because a label may legally contain any octet, NUL
# included (RFC 1035 §2.3.3, RFC 4343 §2.1) — so the NUL terminator is a
# convenience for the common case, not a reliable length. Anything that
# renders this buffer must use `out_len`: `strlen` would stop at the first
# embedded NUL and print `safe.example.com` for `safe.example.com\0.evil.tld`.
# `out_len` is 0 whenever the return is 0.
#
# Returns the offset immediately after the name in the message
# (advancing past any pointer once it's been followed), or 0 on any
# parse error (label too long, name too long, pointer cycle, pointer
# out of bounds).
#
# Pointers (RFC 1035 §4.1.4) make this fiddly: when we follow a
# pointer, the post-name offset must be the slot AFTER the pointer's
# two bytes in the ORIGINAL section, not in whatever earlier slot the
# pointer jumped to. We track `end_off` separately — it's set the
# first time we follow a pointer and never advances thereafter.
fn dns_decode_name(msg, msg_len, off, out, out_len): i64 {
    # Defined even on the error paths below, so a caller that ignores the 0
    # return cannot read a stale length off the stack.
    store64(out_len, 0);
    var cur = off;
    var dst = 0;
    # Seeded at 1 for the root label's own terminator byte, which RFC 1035
    # §2.3.4's 255-octet limit counts. Starting at 0 made the cap one octet
    # lax — caught by tests/dig.tcyr's 63/63/63/62 case, which is exactly 256.
    var wire = 1;
    var end_off = 0;       # 0 = "haven't followed a pointer yet"
    var hops = 0;
    while (1) {
        if (cur >= msg_len) { return 0; }
        var b = load8(msg + cur);
        if (b == 0) {
            store64(out_len, dst);
            store8(out + dst, 0);
            cur = cur + 1;
            if (end_off == 0) { end_off = cur; }
            return end_off;
        }
        if ((b & 0xC0) == 0xC0) {
            # Pointer. Need a second byte.
            if (cur + 1 >= msg_len) { return 0; }
            var b2 = load8(msg + cur + 1);
            var ptr = ((b & 0x3F) << 8) | b2;
            if (ptr >= msg_len) { return 0; }
            if (end_off == 0) { end_off = cur + 2; }
            hops = hops + 1;
            if (hops > NAME_DECODE_MAX_HOPS) { return 0; }
            # RFC 1035 §4.1.4 also requires pointers to point BACKWARD
            # (the destination must already have been parsed). A
            # forward pointer is a sign of a crafted packet; reject.
            if (ptr >= cur) { return 0; }
            cur = ptr;
        } else {
            # Literal label.
            if (b > DNS_MAX_LABEL_LEN) { return 0; }
            if (cur + 1 + b > msg_len) { return 0; }
            # Cap on the WIRE length, matching dns_skip_name. RFC 1035 §2.3.4's
            # 255 is a wire limit; `dst` below is the PRESENTATION length, which
            # for an n-label name is wire-2 (no length prefixes, n-1 dots, no
            # root byte). Capping dst alone accepted wire names up to 257 octets
            # — lax, and lax in a different direction from the walker, which is
            # how the two guards drifted apart in the first place.
            wire = wire + 1 + b;
            if (wire > DNS_MAX_NAME_LEN) { return 0; }
            if (dst > 0) {
                if (dst >= DNS_MAX_NAME_LEN) { return 0; }
                store8(out + dst, 46);    # '.'
                dst = dst + 1;
            }
            var i = 0;
            while (i < b) {
                if (dst >= DNS_MAX_NAME_LEN) { return 0; }
                store8(out + dst, load8(msg + cur + 1 + i));
                dst = dst + 1;
                i = i + 1;
            }
            cur = cur + 1 + b;
        }
    }
    return 0;
}

# Compute the encoded length of a wire name starting at `off` in
# `msg`, WITHOUT decoding. Same pointer-handling discipline as
# dns_decode_name (cycle-budget, must point backward). Returns the
# offset immediately past the name, or 0 on error.
fn dns_skip_name(msg, msg_len, off): i64 {
    var cur = off;
    var end_off = 0;
    var hops = 0;
    var wire = 1;      # the root terminator — see dns_decode_name
    while (1) {
        if (cur >= msg_len) { return 0; }
        var b = load8(msg + cur);
        if (b == 0) {
            cur = cur + 1;
            if (end_off == 0) { end_off = cur; }
            return end_off;
        }
        if ((b & 0xC0) == 0xC0) {
            if (cur + 1 >= msg_len) { return 0; }
            var b2 = load8(msg + cur + 1);
            var ptr = ((b & 0x3F) << 8) | b2;
            if (ptr >= msg_len) { return 0; }
            if (end_off == 0) { end_off = cur + 2; }
            hops = hops + 1;
            if (hops > NAME_DECODE_MAX_HOPS) { return 0; }
            if (ptr >= cur) { return 0; }
            cur = ptr;
        } else {
            if (b > DNS_MAX_LABEL_LEN) { return 0; }
            # Total decompressed WIRE length, capped at RFC 1035 §2.3.4's 255.
            # Without this the walker accepted names the printer could not
            # render: dns_parse_rr would return a valid offset for a 6x63-label
            # owner name while dns_decode_name returned 0, so full output printed
            # `;; ANSWER` with no records under it and exit 0, while `+short` on
            # the identical bytes printed the address. Two modes of one tool
            # disagreeing about the same reply, neither reporting a problem.
            wire = wire + 1 + b;
            if (wire > DNS_MAX_NAME_LEN) { return 0; }
            cur = cur + 1 + b;
        }
    }
    return 0;
}

# === Header accessors / mutators ===

# Every accessor below reads a big-endian u16 out of the fixed 12-byte header.
# NONE of them bounds-check: the caller must have already established that at
# least 12 bytes were received. `query_send_recv` is the only caller and does.

# Query ID (bytes 0-1). Echoed by the responder; the RFC 5452 anti-spoof match.
fn dns_hdr_id(msg):       i64 { return (load8(msg) << 8) | load8(msg + 1); }
# The raw FLAGS word (bytes 2-3): QR|Opcode|AA|TC|RD | RA|Z|RCODE.
fn dns_hdr_flags(msg):    i64 { return (load8(msg + 2) << 8) | load8(msg + 3); }
# QDCOUNT (bytes 4-5) — question records. Attacker-chosen in a response.
fn dns_hdr_qdcount(msg):  i64 { return (load8(msg + 4) << 8) | load8(msg + 5); }
# ANCOUNT (bytes 6-7) — answer records. Attacker-chosen; never trust it as a
# loop bound without also bounding on msg_len.
fn dns_hdr_ancount(msg):  i64 { return (load8(msg + 6) << 8) | load8(msg + 7); }
# NSCOUNT (bytes 8-9) — authority records. Same caveat as ANCOUNT.
fn dns_hdr_nscount(msg):  i64 { return (load8(msg + 8) << 8) | load8(msg + 9); }
# ARCOUNT (bytes 10-11) — additional records. Same caveat as ANCOUNT.
fn dns_hdr_arcount(msg):  i64 { return (load8(msg + 10) << 8) | load8(msg + 11); }
# RCODE — the low 4 bits of FLAGS (RFC 1035 §4.1.1). EDNS extended RCODEs live
# in the OPT pseudo-RR's TTL field and are NOT folded in here; dig does not
# parse OPT yet, so a response using them reports only its low nibble.
fn dns_hdr_rcode(msg):    i64 { return dns_hdr_flags(msg) & 0x000F; }
# 1 if the TC (truncation) bit is set, else 0. A TC=1 reply is a PREFIX of the
# real answer, not a whole one — the caller must not parse it as complete.
fn dns_hdr_truncated(msg):i64 { if ((dns_hdr_flags(msg) & DNS_FLAG_TC) != 0) { return 1; } return 0; }

fn _dns_store_u16(buf, off, val): i64 {
    store8(buf + off,     (val >> 8) & 0xFF);
    store8(buf + off + 1, val & 0xFF);
    return 0;
}

fn _dns_load_u16(buf, off): i64 {
    return (load8(buf + off) << 8) | load8(buf + off + 1);
}

fn _dns_load_u32(buf, off): i64 {
    return (load8(buf + off) << 24) | (load8(buf + off + 1) << 16) | (load8(buf + off + 2) << 8) | load8(buf + off + 3);
}

# Construct a DNS query. Writes the full message to `buf` and returns
# bytes written, or 0 on encoding failure. Buf must hold at least
# DNS_HEADER_LEN + DNS_MAX_NAME_LEN + 2 + 4 = ~273 bytes.
#
# Sets: ID = supplied (caller picks; we don't have a kernel RNG yet
# so the platform layer reads /dev/urandom and passes it in). QR=0,
# Opcode=0, AA=0, TC=0, RD=1, RA=0, Z=0, RCODE=0. QDCOUNT=1,
# ANCOUNT=NSCOUNT=ARCOUNT=0.
fn dns_build_query(buf, id, name, qtype): i64 {
    _dns_store_u16(buf, 0, id);
    _dns_store_u16(buf, 2, DNS_FLAG_RD);
    _dns_store_u16(buf, 4, 1);    # QDCOUNT
    _dns_store_u16(buf, 6, 0);
    _dns_store_u16(buf, 8, 0);
    _dns_store_u16(buf, 10, 0);
    var n = dns_encode_name(name, buf + DNS_HEADER_LEN);
    if (n == 0) { return 0; }
    _dns_store_u16(buf, DNS_HEADER_LEN + n, qtype);
    _dns_store_u16(buf, DNS_HEADER_LEN + n + 2, DNS_CLASS_IN);
    return DNS_HEADER_LEN + n + 4;
}

# Walk past a single question section, return next offset (start of
# answers). Returns 0 on parse error.
fn dns_skip_question(msg, msg_len, off): i64 {
    var p = dns_skip_name(msg, msg_len, off);
    if (p == 0) { return 0; }
    if (p + 4 > msg_len) { return 0; }
    return p + 4;
}

# Walk to the start of the answer section. Handles arbitrary QDCOUNT
# (it's almost always 1, but RFC doesn't forbid more). Returns 0 on
# parse error.
# ASCII-lowercase one byte. DNS names compare case-INSENSITIVELY (RFC 4343),
# and a resolver may echo the question in any case — 0x20-encoding servers
# deliberately randomize it — so the question match must fold case.
fn _dns_lc(c): i64 {
    if (c >= 65) { if (c <= 90) { return c + 32; } }
    return c;
}

# Does this reply answer the question we actually asked? RFC 5452 §9.1.
#
# The query ID is only 16 bits. An off-path attacker who guesses it can
# otherwise return an answer for a DIFFERENT name than the one requested, and
# through 0.3.6 dig would have printed it as the answer — the ID and QR bit were
# the only checks. Comparing the echoed question closes that.
#
# Returns 1 on match, 0 otherwise. Conservative by construction: anything it
# cannot verify (qdcount != 1, a question that runs past the received length, a
# compression pointer where a literal name belongs) returns 0 and the caller
# drops the datagram. A legitimate responder echoes the question verbatim and
# uncompressed — there is nothing before it to point back at.
fn dns_question_matches(msg, msg_len, name, qtype): i64 {
    if (dns_hdr_qdcount(msg) != 1) { return 0; }
    var want[260];
    var wlen = dns_encode_name(name, &want);
    if (wlen == 0) { return 0; }
    if (DNS_HEADER_LEN + wlen + 4 > msg_len) { return 0; }
    var i = 0;
    while (i < wlen) {
        if (_dns_lc(load8(msg + DNS_HEADER_LEN + i)) != _dns_lc(load8(&want + i))) { return 0; }
        i = i + 1;
    }
    if (_dns_load_u16(msg, DNS_HEADER_LEN + wlen) != qtype) { return 0; }
    if (_dns_load_u16(msg, DNS_HEADER_LEN + wlen + 2) != DNS_CLASS_IN) { return 0; }
    return 1;
}

# Offset of the first ANSWER record, i.e. just past the header and the question
# section. Returns 0 if the question cannot be skipped within msg_len — callers
# must treat 0 as "unparseable", not as "offset zero".
fn dns_answer_section_start(msg, msg_len): i64 {
    if (msg_len < DNS_HEADER_LEN) { return 0; }
    var qd = dns_hdr_qdcount(msg);
    var off = DNS_HEADER_LEN;
    var i = 0;
    while (i < qd) {
        off = dns_skip_question(msg, msg_len, off);
        if (off == 0) { return 0; }
        i = i + 1;
    }
    return off;
}

# Parse one resource record at `off`. Writes parsed fields into the
# 40-byte `rr` struct (caller-allocated):
#
#   +0   name_ptr_in_msg  : i64   offset into msg of this RR's name (for re-decode)
#   +8   type             : i64
#   +16  class            : i64
#   +24  ttl              : i64
#   +32  rdata_off        : i64   offset into msg where rdata begins
#   (rdlength inferred via next_off - rdata_off)
#
# Returns the offset immediately after this RR, or 0 on parse error.
var DNS_RR_SIZE = 40;
# Offset within `msg` of this RR's name field — kept so the caller can re-decode
# the (possibly compressed) name on demand rather than buffering it here.
fn dns_rr_name_off(rr):   i64 { return load64(rr); }
# RR TYPE code (DNS_TYPE_*). Unrecognized types are passed through, not rejected.
fn dns_rr_type(rr):       i64 { return load64(rr + 8); }
# RR CLASS code. dig only ever asks IN (1); a reply may still say otherwise.
fn dns_rr_class(rr):      i64 { return load64(rr + 16); }
# TTL in seconds. The RFC types this signed, but it is universally treated as
# unsigned; `_dns_load_u32` zero-extends, so no sign-extension surprise here.
fn dns_rr_ttl(rr):        i64 { return load64(rr + 24); }
# Offset within `msg` where this RR's rdata begins. Its LENGTH is not stored —
# recover it as `next_off - dns_rr_rdata_off(rr)`, using the offset
# `dns_parse_rr` returned. Callers that format rdata must bound every read against that length.
fn dns_rr_rdata_off(rr):  i64 { return load64(rr + 32); }

# Parse the resource record beginning at `off` into the caller's 40-byte `rr`
# struct (layout above). Returns the offset immediately AFTER the record, or 0
# on any parse failure — a 0 return means "stop walking", never "empty record".
#
# Every field is bounds-checked against `msg_len` before it is read: the name is
# skipped through `dns_skip_name` (which enforces the compression-pointer hop
# budget), the 10-byte type/class/ttl/rdlength block must fit, and rdata must
# fit. `msg_len` MUST be the number of bytes actually received, not the capacity
# of the buffer — passing capacity would let a short reply read stale bytes.
fn dns_parse_rr(msg, msg_len, off, rr): i64 {
    if (off >= msg_len) { return 0; }
    var name_off = off;
    var p = dns_skip_name(msg, msg_len, off);
    if (p == 0) { return 0; }
    if (p + 10 > msg_len) { return 0; }
    var rtype = _dns_load_u16(msg, p);
    var rclass = _dns_load_u16(msg, p + 2);
    var ttl = _dns_load_u32(msg, p + 4);
    var rdlen = _dns_load_u16(msg, p + 8);
    var rdata = p + 10;
    if (rdata + rdlen > msg_len) { return 0; }
    store64(rr,      name_off);
    store64(rr + 8,  rtype);
    store64(rr + 16, rclass);
    store64(rr + 24, ttl);
    store64(rr + 32, rdata);
    return rdata + rdlen;
}
