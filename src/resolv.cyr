# resolv.cyr — resolver discovery (/etc/resolv.conf parser).
#
# resolv_parse is pure code: the caller hands it bytes and gets back the first
# `nameserver X.X.X.X` IPv4, packed. resolv_discover reads the file through the
# platform shim and reports a fallback or a refusal on stderr (output.cyr).
#
# Grammar fragment (RFC 1033 / resolver(5)):
#   nameserver <SP+> <addr>
# Lines starting with '#' or ';' are comments. Other directives
# (search, options, sortlist) are skipped. We only care about
# nameserver lines pointing at IPv4; IPv6 waits for an IPv6 transport
# (roadmap § 0.4.x), and a file naming only IPv6 resolvers fails closed.
#
# Discovery order, as the code actually walks it:
#   1. platform_dns_server() — the AGNOS DHCP-leased on-subnet resolver
#      (net_config#61). Returns 0 on Linux, so this step is a no-op there.
#   2. /etc/resolv.conf, first valid `nameserver <dotted-quad>` line.
#   3. RESOLV_FALLBACK_PUBLIC (8.8.8.8).
#
# Through 0.3.7 this header claimed the chain was
# "/etc/resolv.conf -> 192.168.1.1 -> 8.8.8.8", and declared a
# RESOLV_FALLBACK_GATEWAY constant to match. There was no gateway step and the
# constant had no readers — so the header promised that an on-subnet gateway
# would be tried before queries escaped to a third party, which was false, and
# it was the most safety-relevant claim in the file. Both are gone.

var RESOLV_FALLBACK_PUBLIC  = 0x08080808;   # 8.8.8.8
var RESOLV_NAMESERVER_LIT   = "nameserver";   # 10 bytes

# Advance `i` past spaces and tabs. Returns new index.
fn _resolv_skip_blank(buf, len, i): i64 {
    while (i < len) {
        var c = load8(buf + i);
        if (c == 32) { i = i + 1; }
        elif (c == 9) { i = i + 1; }
        else { return i; }
    }
    return i;
}

# Advance `i` to the next newline (or end of buffer). Returns the
# index of the newline (or len).
fn _resolv_find_eol(buf, len, i): i64 {
    while (i < len) {
        if (load8(buf + i) == 10) { return i; }
        i = i + 1;
    }
    return len;
}

# Bounded literal match: does buf[i..i+lit_len) == lit? Returns 1/0.
fn _resolv_match(buf, len, i, lit, lit_len): i64 {
    if (i + lit_len > len) { return 0; }
    var k = 0;
    while (k < lit_len) {
        if (load8(buf + i + k) != load8(lit + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# resolv_parse's answer when the file NAMES nameservers but dig can use none of
# them (IPv6, 0.0.0.0, garbage). Distinct from 0, "no nameserver line at all",
# because the two now get different treatment: see resolv_discover.
var RESOLV_UNUSABLE = 0 - 1;

# Parse `buf[0..len)` as resolv.conf. Returns the packed IPv4 of the first valid
# `nameserver X.X.X.X` line; RESOLV_UNUSABLE if there are nameserver lines but
# none of them is usable; or 0 if there is no nameserver line at all. Caller
# dispatches the fallback.
fn resolv_parse(buf, len): i64 {
    if (buf == 0) { return 0; }
    if (len <= 0) { return 0; }
    var named = 0;          # saw at least one `nameserver` line
    var i = 0;
    while (i < len) {
        i = _resolv_skip_blank(buf, len, i);
        if (i >= len) { break; }
        var c = load8(buf + i);
        # Comment / empty line — skip
        if (c == 35) { i = _resolv_find_eol(buf, len, i) + 1; }
        elif (c == 59) { i = _resolv_find_eol(buf, len, i) + 1; }
        elif (c == 10) { i = i + 1; }
        else {
            # Try to match "nameserver"
            if (_resolv_match(buf, len, i, RESOLV_NAMESERVER_LIT, 10) == 1) {
                # Must be followed by whitespace (no `nameservers`).
                var j = i + 10;
                if (j < len) {
                    var nc = load8(buf + j);
                    if (nc == 32) { j = _resolv_skip_blank(buf, len, j); }
                    elif (nc == 9) { j = _resolv_skip_blank(buf, len, j); }
                    else { j = _resolv_find_eol(buf, len, i) + 1; i = j; continue; }
                    named = 1;
                    # Extract the address token to a temp NUL-terminated
                    # buffer ipv4_parse can consume.
                    var eol = _resolv_find_eol(buf, len, j);
                    # Address ends at first whitespace or eol.
                    var end = j;
                    while (end < eol) {
                        var ec = load8(buf + end);
                        if (ec == 32) { break; }
                        if (ec == 9) { break; }
                        # CR, for a CRLF file. Without this the token is
                        # "1.1.1.1\r", ipv4_parse rejects it, the line is
                        # skipped, and with no other nameserver line discovery
                        # silently fell through to 8.8.8.8 — off-box, to a third
                        # party. (glibc has the same CRLF limitation but fails
                        # CLOSED, to 127.0.0.1. Deliberately NOT adding CR to
                        # _resolv_skip_blank: CR is not whitespace in the
                        # resolver(5) grammar, and accepting `nameserver\r 1.2.3.4`
                        # would make dig laxer than both glibc and BIND.)
                        if (ec == 13) { break; }
                        end = end + 1;
                    }
                    var tlen = end - j;
                    if (tlen > 0) {
                        if (tlen <= 64) {
                            var tmp[80];
                            var k2 = 0;
                            while (k2 < tlen) {
                                store8(&tmp + k2, load8(buf + j + k2));
                                k2 = k2 + 1;
                            }
                            store8(&tmp + tlen, 0);
                            var addr = ipv4_parse(&tmp);
                            # `> 0`, not `>= 0`. 0 is this function's documented
                            # "nothing found" sentinel and the caller tests
                            # `> 0` — so `nameserver 0.0.0.0` used to "succeed"
                            # with 0, abandoning the rest of the file, and the
                            # caller then read that as failure and used 8.8.8.8.
                            # Proven: a resolv.conf of `0.0.0.0` then `1.1.1.1`
                            # queried 8.8.8.8; now it queries 1.1.1.1. (The
                            # point is producer/consumer agreement, not that
                            # 0.0.0.0 is unusable — the kernel remaps it.)
                            if (addr > 0) { return addr; }
                        }
                    }
                    i = eol + 1;
                } else { named = 1; break; }
            } else {
                i = _resolv_find_eol(buf, len, i) + 1;
            }
        }
    }
    if (named == 1) { return RESOLV_UNUSABLE; }
    return 0;
}

var RESOLV_CONF_MAX = 16384;

# resolv_discover's answer when it FAILS CLOSED: there is a resolv.conf that
# names resolvers, but none dig can use. Negative, so no address collides.
var RESOLV_NONE = 0 - 1;

# Pick the resolver to ask. Returns a packed IPv4, or RESOLV_NONE. Caller can
# override entirely via the `@server` CLI arg before this is called.
#
# On AGNOS the DHCP-leased on-subnet resolver (net_config#61, via
# platform_dns_server) is preferred FIRST — the 8.8.8.8 fallback is off-subnet
# and needs working gateway routing the kernel can't guarantee on real iron (it
# froze bare-hostname net tools on archaemenid); the leased resolver is
# on-subnet + directly reachable. Linux's platform_dns_server returns 0, so the
# resolv.conf path is unchanged there.
#
# Then /etc/resolv.conf, and the policy for when it yields nothing (0.5.2, the
# same posture as taar 0.6.2):
#   - no file, or a file with no `nameserver` line at all: there is no host
#     resolver to bypass, so fall back to RESOLV_FALLBACK_PUBLIC (8.8.8.8), with
#     a warning on stderr;
#   - a file that NAMES resolvers dig cannot use (IPv6, 0.0.0.0, garbage), or
#     whose only candidate line was cut off at the read limit: FAIL CLOSED. The
#     host chose its resolvers; quietly sending the query to a third party
#     instead is the leak to avoid. Through 0.5.1 this case went to 8.8.8.8 too.
fn resolv_discover(): i64 {
    var ksrv = platform_dns_server();
    if (ksrv > 0) { return ksrv; }
    # Read ONE byte more than the cap, so a file that does not fit is KNOWN not
    # to fit. Through 0.5.1 a file over the 16 KiB cap was cut silently, and a
    # nameserver line straddling the cut parsed as a DIFFERENT valid address:
    # `nameserver 10.0.0.53` with its `3` at byte 16384 queried 10.0.0.5, with no
    # warning. (At 0.3.8 the same bug sat at 4096; raising the cap moved it.)
    # Now the partial last line is dropped before parsing, never read.
    var buf = alloc(RESOLV_CONF_MAX + 1);
    var n = platform_read_file("/etc/resolv.conf", buf, RESOLV_CONF_MAX + 1);
    var cut = 0;
    if (n > RESOLV_CONF_MAX) {
        cut = 1;
        n = RESOLV_CONF_MAX;
        while (n > 0) {
            if (load8(buf + n - 1) == 10) { break; }
            n = n - 1;
        }
    }
    var addr = 0;
    if (n > 0) { addr = resolv_parse(buf, n); }
    if (addr > 0) { return addr; }
    if ((addr == RESOLV_UNUSABLE) || (cut == 1)) {
        _out_eputs(";; no usable nameserver in /etc/resolv.conf, which names some");
        _out_eputs(" (not falling back to a public resolver); give one with @server\n");
        return RESOLV_NONE;
    }
    # Say so. `+short` and the timeout path never print the footer that would
    # show `server: 8.8.8.8`, so this line on stderr is the only notice.
    _out_eputs(";; WARNING: no nameserver in /etc/resolv.conf");
    _out_eputs(" — falling back to 8.8.8.8\n");
    return RESOLV_FALLBACK_PUBLIC;
}
