# query.cyr — DNS query orchestration.
#
# Send a query, receive a response, retry on timeout. Tracks
# wall-clock query time for the "Query time: N ms" footer.
#
# Returns:
#   QRY_OK     0  — got a response (response in rx buf, length in *resp_len)
#   QRY_TIMEOUT 1 — exhausted retries with no reply
#   QRY_BAD    2  — the query could not be BUILT (name unencodable). Not a
#                   response condition: main.cyr validates the name up front, so
#                   this is unreachable in practice and kept only as a backstop.
#                   Real malformed-response cases have their own messages in
#                   main.cyr and never come through here.
#   QRY_SOCKET 3  — couldn't open the socket
#
# rx buf: caller provides ≥ DNS_MAX_UDP_PAYLOAD bytes.
# resp_len: out param (8-byte slot the caller allocs); we store the
#           response length there on success.
# query_us: out param (8-byte slot); we store the round-trip latency
#           in microseconds.

var QRY_OK      = 0;
var QRY_TIMEOUT = 1;
var QRY_BAD     = 2;
var QRY_SOCKET  = 3;

var DNS_PORT = 53;

# Is this datagram an acceptable reply to the query we sent? 1 yes, 0 no.
#
# THE ACCEPTANCE POLICY, deliberately split out of the transport loop so it can
# be asserted without a socket. Every guard here could be deleted with the whole
# suite still green before 0.3.8 — including the RFC 5452 §9.1 question check
# that 0.3.7 exists to have added. `dns_question_matches` was well tested as a
# FUNCTION; its USE was not tested at all, which is the gap that matters.
#
# Four independent things must hold, and the order is cheapest-first:
#   1. long enough to hold a header at all;
#   2. echoes the 16-bit ID we generated for THIS attempt;
#   3. has QR set, so it is a response and not someone's query;
#   4. answers the question we actually asked (RFC 5452 §9.1) — without this, an
#      attacker who guesses the ID can answer for a different name entirely.
#
# On the Linux arm the connected socket has already dropped off-peer datagrams
# before any of this runs, and on AGNOS platform_udp_recv does the same check by
# hand; these four are the layer above that, not a substitute for it.
fn query_reply_acceptable(rx, n, id, name, qtype): i64 {
    if (n < DNS_HEADER_LEN) { return 0; }
    if (dns_hdr_id(rx) != id) { return 0; }
    if ((dns_hdr_flags(rx) & DNS_FLAG_QR) == 0) { return 0; }
    if (dns_question_matches(rx, n, name, qtype) == 0) { return 0; }
    return 1;
}

# Build a query for `name`/`qtype`, send it to `server_addr` over UDP-53, and
# wait for a reply — retrying up to `retry` ATTEMPTS with a `timeout_s` deadline
# on each. On success, writes the reply into `rx` (capacity `rx_cap` bytes),
# stores the received length through `resp_len` and the round-trip time in
# microseconds through `query_us`.
#
# Returns QRY_OK, or QRY_TIMEOUT (no reply within the budget), QRY_BAD (the
# query could not be built from this name — not a response condition) or
# QRY_SOCKET (the transport itself failed, including entropy failure).
#
# `*resp_len` is the authoritative length for every downstream parse — pass it,
# not `rx_cap`, to `dns_parse_rr` and friends, or a short reply will be parsed
# against stale buffer contents.
fn query_send_recv(server_addr, name, qtype, timeout_s, retry, rx, rx_cap, resp_len, query_us): i64 {
    var fd = platform_udp_open();
    if (fd < 0) { return QRY_SOCKET; }

    # An unchecked failure here means an unbounded recv — the process would hang
    # with no way out but a signal. Treat it as a transport failure.
    if (platform_set_recv_timeout_ms(fd, timeout_s * 1000) < 0) {
        platform_close(fd);
        return QRY_SOCKET;
    }

    var tx = alloc(DNS_MAX_UDP_PAYLOAD);
    var tries = 0;
    if (retry < 1) { retry = 1; }

    while (tries < retry) {
        tries = tries + 1;

        # A FRESH query ID per attempt (RFC 5452 §9). Reusing one ID across
        # retries would hand an off-path attacker a second and third guess at
        # the same 16 bits on the same ephemeral port.
        var id = platform_random_u16();
        # Entropy failure is fatal, never fall back to a guessable ID: a
        # predictable query ID is the whole cache-poisoning problem.
        if (id < 0) {
            platform_close(fd);
            return QRY_SOCKET;
        }

        var tx_len = dns_build_query(tx, id, name, qtype);
        # A name we cannot encode will not encode on the next try either.
        if (tx_len == 0) {
            platform_close(fd);
            return QRY_BAD;
        }

        var t0 = platform_now_us();
        if (platform_udp_send_to(fd, server_addr, DNS_PORT, tx, tx_len) < 0) {
            continue;
        }

        # Keep reading until this attempt's deadline, rather than treating one
        # unacceptable datagram as a failed attempt. Through 0.3.6 a rejected
        # reply consumed a retry AND re-sent immediately, so anyone who could
        # spray junk at the socket burned the whole retry budget in microseconds
        # and dig reported "connection timed out". Now junk costs the attacker a
        # packet and costs dig one loop iteration.
        var deadline = t0 + timeout_s * 1000000;
        while (platform_now_us() < deadline) {
            # Re-arm SO_RCVTIMEO to the REMAINING budget before each recv.
            # The loop condition bounds when a recv may START, never when it
            # must END — so through 0.3.7, one junk datagram timed to arrive
            # just before the deadline bought a whole extra timeout window.
            # Measured: `+timeout=1 +retry=1` went 1.06s -> 1.92s from a single
            # well-placed packet, and the shipped defaults 15.3s -> 30.7s. Bound
            # was exactly 2x per attempt. Note a FLOOD never triggered it — the
            # loop condition handles that correctly; precision was the attack.
            #
            # The `< 1` guard is load-bearing, not padding: the loop guarantees
            # only a positive MICROsecond remainder, so this division can floor
            # to 0, and platform_set_recv_timeout_ms clamps 0 up to 1ms — which
            # would spin here rather than exit.
            var left_ms = (deadline - platform_now_us()) / 1000;
            if (left_ms < 1) { break; }
            if (platform_set_recv_timeout_ms(fd, left_ms) < 0) { break; }
            var n = platform_udp_recv(fd, rx, rx_cap);
            # Deadline expired inside the kernel — this attempt is over.
            if (n == PLATFORM_ERR_TIMEOUT) { break; }
            # Any other transport error ends the attempt too.
            if (n < 0) { break; }
            if (query_reply_acceptable(rx, n, id, name, qtype) == 0) { continue; }

            store64(resp_len, n);
            store64(query_us, platform_now_us() - t0);
            platform_close(fd);
            return QRY_OK;
        }
    }

    platform_close(fd);
    return QRY_TIMEOUT;
}
