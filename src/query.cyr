# query.cyr — DNS query orchestration.
#
# Send a query, receive a response, retry on timeout. Tracks
# wall-clock query time for the "Query time: N ms" footer.
#
# Returns:
#   QRY_OK      0 — got an acceptable reply (in rx, length in *resp_len)
#   QRY_TIMEOUT 1 — every try ran out of time without an acceptable reply
#   QRY_BAD     2 — the query could not be BUILT (name unencodable). Not a
#                   response condition: main.cyr validates the name up front, so
#                   this is unreachable in practice and kept only as a backstop.
#   QRY_SOCKET  3 — a socket could not be opened or armed (an internal error)
#   QRY_REFUSED 4 — the server's port refused us (ECONNREFUSED)
#   QRY_NETERR  5 — another transport failure; the errno is in query_last_err
#   QRY_ENTROPY 6 — the kernel could not supply entropy for the query ID
#
# Through 0.5.1 the last three all printed "connection timed out", after zero
# seconds, and entropy failure printed "cannot open UDP socket" even for +tcp.
#
# rx buf: caller provides the capacity it passes as rx_cap.
# resp_len: out param (8-byte slot the caller allocs); written ONLY on QRY_OK.
# query_us: out param (8-byte slot); the round-trip latency in microseconds.

var QRY_OK      = 0;
var QRY_TIMEOUT = 1;
var QRY_BAD     = 2;
var QRY_SOCKET  = 3;
var QRY_REFUSED = 4;
var QRY_NETERR  = 5;
var QRY_ENTROPY = 6;

# The errno (or TCP_ERR_*) behind the last QRY_NETERR, for main's message.
var query_last_err = 0;

var DIG_ECONNREFUSED = 0 - 111;
# -EINTR. With SO_RCVTIMEO set, Linux does not restart an interrupted recv: a
# SIGSTOP/SIGCONT returns this, and through 0.5.1 it ended the attempt early.
var DIG_EINTR        = 0 - 4;

var DNS_PORT = 53;

# Is this datagram an acceptable reply to the query we sent? 1 yes, 0 no.
#
# THE ACCEPTANCE POLICY, deliberately split out of the transport loop so it can
# be asserted without a socket. Every guard here could be deleted with the whole
# suite still green before 0.3.8 — including the RFC 5452 §9.1 question check
# that 0.3.7 exists to have added. `dns_question_matches` was well tested as a
# FUNCTION; its USE was not tested at all, which is the gap that matters.
#
# Four independent things must hold, and the order is cheapest-first:
#   1. long enough to hold a header at all;
#   2. echoes the 16-bit ID we generated for THIS attempt;
#   3. has QR set, so it is a response and not someone's query;
#   4. answers the question we actually asked (RFC 5452 §9.1) — without this, an
#      attacker who guesses the ID can answer for a different name entirely.
#
# On the Linux arm the connected socket has already dropped off-peer datagrams
# before any of this runs, and on AGNOS platform_udp_recv does the same check by
# hand; these four are the layer above that, not a substitute for it.
#
# Two more since 0.5.2:
#   5. the OPCODE must be QUERY (0), the only one dig sends. Through 0.5.1 a
#      reply with opcode STATUS was accepted and printed as `opcode: QUERY`;
#   6. QDCOUNT=0 is admitted in exactly ONE shape: an error (RCODE != NOERROR)
#      carrying no answer and no authority records. A server that cannot parse
#      a query (FORMERR) may have no question to echo, and through 0.5.1 dig
#      dropped those replies and reported "connection timed out" after the whole
#      retry budget; BIND accepts them. The shape carries no records, so there
#      is nothing in it for §9.1 to protect. Anything else without a question,
#      and any QDCOUNT > 1, is still dropped.
fn query_reply_acceptable(rx, n, id, name, qtype): i64 {
    if (n < DNS_HEADER_LEN) { return 0; }
    if (dns_hdr_id(rx) != id) { return 0; }
    var flags = dns_hdr_flags(rx);
    if ((flags & DNS_FLAG_QR) == 0) { return 0; }
    if (((flags >> 11) & 0xF) != 0) { return 0; }
    if (dns_hdr_qdcount(rx) == 0) {
        if (dns_hdr_rcode(rx) == DNS_RCODE_NOERROR) { return 0; }
        if (dns_hdr_ancount(rx) != 0) { return 0; }
        if (dns_hdr_nscount(rx) != 0) { return 0; }
        return 1;
    }
    if (dns_question_matches(rx, n, name, qtype) == 0) { return 0; }
    return 1;
}

# Commit an ACCEPTED reply: copy `n` bytes from the receive scratch `src` into
# the caller's `rx` (capacity `rx_cap`) and store `n` through `resp_len`.
# Returns 1 when committed, 0 when the reply is not acceptable — and on 0 it
# writes NOTHING, so `rx` and `*resp_len` keep whatever they held.
#
# THAT CONTRACT IS THE POINT (0.5.2). Through 0.5.1 both transports received
# straight into the caller's `rx`, before the acceptance checks ran. On UDP that
# was harmless only because main never read `rx` after a failure. On the TC=1
# fallback it was not: `rx` already held the accepted UDP reply, the TCP read
# overwrote it, and when that TCP reply was then REJECTED (wrong ID, wrong
# question, QR clear) or cut short, main printed the rejected bytes as the
# answer, against the UDP reply's length, with exit 0. A hostile `@server` could
# answer a different question than the one asked and bypass every check above.
fn query_commit_reply(src, n, id, name, qtype, rx, rx_cap, resp_len): i64 {
    if (n > rx_cap) { return 0; }
    if (query_reply_acceptable(src, n, id, name, qtype) == 0) { return 0; }
    memcpy(rx, src, n);
    store64(resp_len, n);
    return 1;
}

# Build a query for `name`/`qtype`, send it to `server_addr` over UDP-53, and
# wait for a reply — up to `tries` ATTEMPTS with a `timeout_s` deadline on each.
# On success, writes the reply into `rx` (capacity `rx_cap` bytes), stores the
# received length through `resp_len` and the round-trip time in microseconds
# through `query_us`.
#
# Returns QRY_OK, or one of the failure codes in the header. When every attempt
# fails, the LAST attempt's reason is what is reported: a refusal, another
# transport errno (QRY_NETERR, errno in query_last_err), or a plain timeout.
#
# `*resp_len` is the authoritative length for every downstream parse — pass it,
# not `rx_cap`, to `dns_parse_rr` and friends, or a short reply will be parsed
# against stale buffer contents.
fn query_send_recv(server_addr, name, qtype, timeout_s, tries, rx, rx_cap, resp_len, query_us, edns, do_bit): i64 {
    var tx = alloc(DNS_MAX_UDP_PAYLOAD);
    # Datagrams land here, never in `rx`: see query_commit_reply.
    var urx = alloc(rx_cap);
    var tried = 0;
    var last = 0;          # why the last attempt ended: 0 timeout, else an errno
    if (tries < 1) { tries = 1; }

    while (tried < tries) {
        tried = tried + 1;

        # A FRESH socket, and so a fresh ephemeral source port, per attempt, as
        # well as a fresh ID (RFC 5452 §9.2). Through 0.5.1 one socket served
        # every try, so a retry changed only the 16-bit ID and an off-path
        # attacker who had learned the port kept it. BIND opens one per try too.
        var fd = platform_udp_open();
        if (fd < 0) { return QRY_SOCKET; }

        # A FRESH query ID per attempt (RFC 5452 §9). Reusing one ID across
        # retries would hand an off-path attacker a second and third guess at
        # the same 16 bits.
        var id = platform_random_u16();
        # Entropy failure is fatal, never fall back to a guessable ID: a
        # predictable query ID is the whole cache-poisoning problem.
        if (id < 0) {
            platform_close(fd);
            return QRY_ENTROPY;
        }

        var tx_len = dns_build_query(tx, id, name, qtype, edns, do_bit);
        # A name we cannot encode will not encode on the next try either.
        if (tx_len == 0) {
            platform_close(fd);
            return QRY_BAD;
        }

        var t0 = platform_now_us();
        var sent = platform_udp_send_to(fd, server_addr, DNS_PORT, tx, tx_len);
        if (sent < 0) {
            last = sent;
            platform_close(fd);
            continue;
        }
        last = 0;

        # Keep reading until this attempt's deadline, rather than treating one
        # unacceptable datagram as a failed attempt. Through 0.3.6 a rejected
        # reply consumed a retry AND re-sent immediately, so anyone who could
        # spray junk at the socket burned the whole retry budget in microseconds
        # and dig reported "connection timed out". Now junk costs the attacker a
        # packet and costs dig one loop iteration.
        var deadline = t0 + timeout_s * 1000000;
        while (platform_now_us() < deadline) {
            # Re-arm SO_RCVTIMEO to the REMAINING budget before each recv.
            # The loop condition bounds when a recv may START, never when it
            # must END — so through 0.3.7, one junk datagram timed to arrive
            # just before the deadline bought a whole extra timeout window.
            # Measured: `+timeout=1 +retry=1` went 1.06s -> 1.92s from a single
            # well-placed packet, and the shipped defaults 15.3s -> 30.7s. Bound
            # was exactly 2x per attempt. Note a FLOOD never triggered it — the
            # loop condition handles that correctly; precision was the attack.
            #
            # The `< 1` guard is load-bearing, not padding: the loop guarantees
            # only a positive MICROsecond remainder, so this division can floor
            # to 0, and platform_set_recv_timeout_ms clamps 0 up to 1ms — which
            # would spin here rather than exit.
            #
            # An unchecked arming failure would mean an unbounded recv, so it is
            # a socket failure, not a soft one.
            var left_ms = (deadline - platform_now_us()) / 1000;
            if (left_ms < 1) { break; }
            if (platform_set_recv_timeout_ms(fd, left_ms) < 0) {
                platform_close(fd);
                return QRY_SOCKET;
            }
            var n = platform_udp_recv(fd, urx, rx_cap);
            # Deadline expired inside the kernel — this attempt is over.
            if (n == PLATFORM_ERR_TIMEOUT) { break; }
            # Interrupted (stop/continue): re-arm to what is left and go on.
            if (n == DIG_EINTR) { continue; }
            # Any other transport error ends the attempt, and is remembered so
            # the user hears "connection refused" rather than "timed out".
            if (n < 0) { last = n; break; }
            if (query_commit_reply(urx, n, id, name, qtype, rx, rx_cap, resp_len) == 0) { continue; }

            store64(query_us, platform_now_us() - t0);
            platform_close(fd);
            return QRY_OK;
        }
        platform_close(fd);
    }

    return query_fail_code(last);
}

# Map why the last attempt failed (0 for a timeout, else a negative errno or
# TCP_ERR_*) to a QRY_* code, recording the errno for main's message.
fn query_fail_code(err): i64 {
    query_last_err = err;
    if (err == 0) { return QRY_TIMEOUT; }
    if (err == PLATFORM_ERR_TIMEOUT) { return QRY_TIMEOUT; }
    if (err == DIG_ECONNREFUSED) { return QRY_REFUSED; }
    return QRY_NETERR;
}

# Ask over TCP-53 instead of UDP. Same contract as query_send_recv, minus the
# retry loop: TCP either connects and answers or it does not, and re-dialling a
# refused port three times is just three refusals.
#
# Reached two ways — `+tcp`, and automatically when a UDP reply comes back with
# TC=1 (RFC 1035 §4.2.2). The acceptance checks are the SAME ones the UDP path
# uses, which matters more than it looks: a stream reply is not automatically
# trustworthy just because it arrived over a connection dig opened. The ID must
# still echo, QR must still be set, and the question must still match, because
# `@server` may be hostile even when the transport is honest.
#
# Defined here rather than in tcp.cyr so the acceptance policy has exactly one
# home; tcp.cyr owns framing and sockets, this owns "is this our answer".
fn query_send_recv_tcp(server_addr, name, qtype, timeout_s, rx, rx_cap, resp_len, query_us, edns, do_bit): i64 {
    var id = platform_random_u16();
    if (id < 0) { return QRY_ENTROPY; }

    var tx = alloc(DNS_MAX_UDP_PAYLOAD);
    var tx_len = dns_build_query(tx, id, name, qtype, edns, do_bit);
    if (tx_len == 0) { return QRY_BAD; }

    # The stream is read into private scratch and committed only once accepted.
    # On the TC=1 fallback `rx` still holds the accepted UDP reply main falls
    # back to printing, so this path must not touch it unless it succeeds.
    var trx = alloc(rx_cap);
    var t0 = platform_now_us();
    var n = tcp_query(server_addr, tx, tx_len, trx, rx_cap, timeout_s);
    if (n < 0) { return query_fail_code(n); }
    var t1 = platform_now_us();

    # A reply that arrived but is not ours is reported as no reply, as on UDP:
    # BIND keeps waiting past an ID mismatch, and here the stream is spent.
    if (query_commit_reply(trx, n, id, name, qtype, rx, rx_cap, resp_len) == 0) { return QRY_TIMEOUT; }

    store64(query_us, t1 - t0);
    return QRY_OK;
}
