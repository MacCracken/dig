# dig benchmarks — the reply path, a stage at a time (0.5.2).
#
# Through 0.5.1 this file benchmarked a no-op. These time the functions every
# reply runs through, on a fixture with the shape real answers have: a question
# for "www.example.com", 59 A records whose owners are compression pointers back
# to it, and an OPT in the additional section.
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop ->
# bench_report. For sub-1us ops use batch_size >= 1000 to amortize the clock
# read (see lib/bench.cyr's header for the overhead-vs-batching guidance).
#
# Stdlib auto-included via cyrius.cyml.
include "lib/taar.cyr"
include "src/dns.cyr"
include "src/platform.cyr"
include "src/resolv.cyr"
include "src/cli.cyr"
include "src/output.cyr"
include "src/query.cyr"
include "src/tcp.cyr"

var BN = 200000;
var BN_WALK = 20000;
var BN_RECORDS = 59;
var _bm = 0;
var _bm_len = 0;

fn _bm_build(): i64 {
    _bm = alloc(2048);
    memset(_bm, 0, 2048);
    store8(_bm + 2, 0x81); store8(_bm + 3, 0x80);
    store8(_bm + 5, 1);                         # qdcount 1
    store8(_bm + 7, BN_RECORDS);                # ancount
    store8(_bm + 11, 1);                        # arcount 1: the OPT
    var q = dns_encode_name("www.example.com", _bm + 12);
    var o = 12 + q;
    store8(_bm + o + 1, 1); store8(_bm + o + 3, 1);
    o = o + 4;
    var i = 0;
    while (i < BN_RECORDS) {
        store8(_bm + o, 0xC0); store8(_bm + o + 1, 12);
        store8(_bm + o + 3, 1); store8(_bm + o + 5, 1);
        store8(_bm + o + 9, 4); store8(_bm + o + 11, 4);
        store8(_bm + o + 12, 10); store8(_bm + o + 15, i);
        o = o + 16;
        i = i + 1;
    }
    # OPT: root owner, TYPE 41, payload 1232, ttl 0, rdlength 0.
    store8(_bm + o + 2, 41); store8(_bm + o + 3, 0x04); store8(_bm + o + 4, 0xD0);
    _bm_len = o + 11;
    return 0;
}

# Decode a compressed owner name.
fn bench_decode_name(): i64 {
    var out[DNS_NAME_BUF_LEN]; var ol[8];
    var b = bench_new("dns_decode_name (pointer -> 3 labels)");
    bench_batch_start(b);
    var i = 0; while (i < BN) { dns_decode_name(_bm, _bm_len, 33, &out, &ol); i = i + 1; }
    bench_batch_stop(b, BN); bench_report(b); return 0;
}

# Walk past a literal name without decoding it.
fn bench_skip_name(): i64 {
    var b = bench_new("dns_skip_name (literal question)");
    bench_batch_start(b);
    var i = 0; while (i < BN) { dns_skip_name(_bm, _bm_len, 12); i = i + 1; }
    bench_batch_stop(b, BN); bench_report(b); return 0;
}

# Parse all 59 answer records.
fn bench_walk_answers(): i64 {
    var rr = alloc(DNS_RR_SIZE);
    var b = bench_new("answer walk: 59 x dns_parse_rr");
    bench_batch_start(b);
    var i = 0;
    while (i < BN_WALK) {
        var off = dns_answer_section_start(_bm, _bm_len);
        var k = 0;
        while (k < BN_RECORDS) { off = dns_parse_rr(_bm, _bm_len, off, rr); k = k + 1; }
        i = i + 1;
    }
    bench_batch_stop(b, BN_WALK); bench_report(b); return 0;
}

# Walk to the OPT and fold the extended RCODE.
fn bench_full_rcode(): i64 {
    var b = bench_new("dns_full_rcode (walk 59 RRs to the OPT)");
    bench_batch_start(b);
    var i = 0; while (i < BN_WALK) { dns_full_rcode(_bm, _bm_len, 1); i = i + 1; }
    bench_batch_stop(b, BN_WALK); bench_report(b); return 0;
}

# Build an EDNS query.
fn bench_build_query(): i64 {
    var tx[512];
    var b = bench_new("dns_build_query (EDNS)");
    bench_batch_start(b);
    var i = 0; while (i < BN) { dns_build_query(&tx, 0x1234, "www.example.com", 1, 1232, 0); i = i + 1; }
    bench_batch_stop(b, BN); bench_report(b); return 0;
}

# Run the whole reply-acceptance policy.
fn bench_accept(): i64 {
    store8(_bm, 0x12); store8(_bm + 1, 0x34);
    var b = bench_new("query_reply_acceptable (ID, QR, opcode, question)");
    bench_batch_start(b);
    var i = 0; while (i < BN) { query_reply_acceptable(_bm, _bm_len, 0x1234, "WWW.example.COM", 1); i = i + 1; }
    bench_batch_stop(b, BN); bench_report(b); return 0;
}

# Escape one maximal TXT character-string.
fn bench_escape(): i64 {
    var src[256]; var dst[1024];
    var k = 0; while (k < 255) { store8(&src + k, 32 + (k % 95)); k = k + 1; }
    var b = bench_new("_esc_to_buf (255-byte TXT string)");
    bench_batch_start(b);
    var i = 0; while (i < 50000) { _esc_to_buf(&dst, 1024, &src, 255, 0); i = i + 1; }
    bench_batch_stop(b, 50000); bench_report(b); return 0;
}

# Render one AAAA per RFC 5952.
fn bench_aaaa(): i64 {
    var raw[16]; var out[64];
    memset(&raw, 0, 16); store8(&raw, 0x20); store8(&raw + 1, 1); store8(&raw + 15, 1);
    var b = bench_new("_aaaa_to_buf (2001::1)");
    bench_batch_start(b);
    var i = 0; while (i < BN) { _aaaa_to_buf(&out, &raw, 0); i = i + 1; }
    bench_batch_stop(b, BN); bench_report(b); return 0;
}

# Rendering into the stdout buffer, discarded each pass, so this times the
# formatting and none of the write(2).
fn bench_render(): i64 {
    var rr = alloc(DNS_RR_SIZE);
    var b = bench_new("render 59 answer lines (buffered)");
    bench_batch_start(b);
    var i = 0;
    while (i < 2000) {
        var off = dns_answer_section_start(_bm, _bm_len);
        var k = 0;
        while (k < BN_RECORDS) {
            var nx = dns_parse_rr(_bm, _bm_len, off, rr);
            output_print_answer_rr(_bm, _bm_len, rr, nx);
            off = nx;
            k = k + 1;
        }
        _out_n = 0;
        i = i + 1;
    }
    bench_batch_stop(b, 2000); bench_report(b); return 0;
}

# Tokenize a five-token command line.
fn bench_cli(): i64 {
    var av[64];
    store64(&av, "dig"); store64(&av + 8, "@8.8.8.8"); store64(&av + 16, "+short");
    store64(&av + 24, "example.com"); store64(&av + 32, "AAAA");
    var r = dig_cli_new();
    var b = bench_new("dig_cli_parse_argv (5 tokens)");
    bench_batch_start(b);
    var i = 0; while (i < BN) { dig_cli_parse_argv(r, 5, &av); store64(r, 0); i = i + 1; }
    bench_batch_stop(b, BN); bench_report(b); return 0;
}

# Build the fixture and run every benchmark.
fn main(): i64 {
    alloc_init();
    _bm_build();
    bench_decode_name();
    bench_skip_name();
    bench_walk_answers();
    bench_full_rcode();
    bench_build_query();
    bench_accept();
    bench_escape();
    bench_aaaa();
    bench_render();
    bench_cli();
    return 0;
}

var r = main();
# Clamp before exiting: a wait status is only 8 bits, so any exit code that is
# a multiple of 256 truncates to 0 and would score PASS. Any failure at all is
# exit 1.
if (r > 0) { r = 1; }
sys_exit_group(r);
