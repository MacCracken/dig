# dig test suite — pure-code coverage of the parser surface.
#
# Stdlib auto-included via cyrius.cyml.
#
# Network paths (UDP send/recv) are exercised by the real binary
# rather than this suite — too much variance vs. a live resolver to
# make for reliable CI. Everything else lives here: ipv4 parsing,
# DNS query construction, name encoding/decoding, name-compression
# cycle detection (security-critical: malicious responses must NOT
# lock the parser), resolv.conf line parsing, RR parsing.

include "lib/taar.cyr"
include "src/dns.cyr"
include "src/platform.cyr"
include "src/resolv.cyr"
include "src/cli.cyr"
include "src/output.cyr"
include "src/query.cyr"

# === IPv4 parser ===
# The one thing coupling DNS_NAME_BUF_LEN to DNS_MAX_NAME_LEN. cyrius cannot
# take an expression as an array size, so the derivation lives here or nowhere.
fn test_name_buf_contract() {
    test_group("name_buf_contract");
    assert_eq(DNS_NAME_BUF_LEN, DNS_MAX_NAME_LEN + 1, "name buffer is exactly max-name + NUL");
    return 0;
}

fn test_ipv4() {
    test_group("ipv4");
    assert_eq(ipv4_parse("0.0.0.0"),         0x00000000, "ipv4 zeros");
    assert_eq(ipv4_parse("127.0.0.1"),       0x7F000001, "ipv4 loopback");
    assert_eq(ipv4_parse("8.8.8.8"),         0x08080808, "ipv4 google");
    assert_eq(ipv4_parse("192.168.1.1"),     0xC0A80101, "ipv4 gateway");
    assert_eq(ipv4_parse("255.255.255.255"), 0xFFFFFFFF, "ipv4 broadcast");

    # Rejection cases.
    assert_eq(ipv4_parse("256.0.0.0"),     IPV4_PARSE_FAIL, "ipv4 octet > 255");
    assert_eq(ipv4_parse("1.2.3"),         IPV4_PARSE_FAIL, "ipv4 only 3 octets");
    assert_eq(ipv4_parse("1.2.3.4.5"),     IPV4_PARSE_FAIL, "ipv4 5 octets");
    assert_eq(ipv4_parse("1.2..4"),        IPV4_PARSE_FAIL, "ipv4 empty segment");
    assert_eq(ipv4_parse(""),              IPV4_PARSE_FAIL, "ipv4 empty string");
    assert_eq(ipv4_parse("1.2.3.4 "),      IPV4_PARSE_FAIL, "ipv4 trailing space");
    return 0;
}

# === DNS query construction ===
fn test_dns_query_build() {
    test_group("dns_query_build");
    var buf[300];
    var n = dns_build_query(&buf, 0x1234, "example.com", DNS_TYPE_A);
    # Header(12) + qname(13 = 7+5+1) + qtype(2) + qclass(2) = 29 bytes
    # qname encoding of "example.com": 07 'example' 03 'com' 00
    assert_eq(n, 29, "query length");
    assert_eq(load8(&buf),     0x12, "id hi byte");
    assert_eq(load8(&buf + 1), 0x34, "id lo byte");
    assert_eq(load8(&buf + 2), 0x01, "flags hi = RD bit");
    assert_eq(load8(&buf + 3), 0x00, "flags lo");
    assert_eq(load8(&buf + 4), 0x00, "qdcount hi");
    assert_eq(load8(&buf + 5), 0x01, "qdcount lo = 1");
    assert_eq(load8(&buf + 6), 0x00, "ancount hi");
    assert_eq(load8(&buf + 7), 0x00, "ancount lo");
    assert_eq(load8(&buf + 12), 7,   "first label length");
    assert_eq(load8(&buf + 13), 101, "first label byte = 'e'");
    assert_eq(load8(&buf + 20), 3,   "second label length = 3");
    assert_eq(load8(&buf + 21), 99,  "second label byte = 'c'");
    assert_eq(load8(&buf + 24), 0,   "root label terminator");
    assert_eq(load8(&buf + 25), 0,   "qtype hi");
    assert_eq(load8(&buf + 26), 1,   "qtype lo = A");
    assert_eq(load8(&buf + 27), 0,   "qclass hi");
    assert_eq(load8(&buf + 28), 1,   "qclass lo = IN");
    return 0;
}

fn test_dns_name_encode() {
    test_group("dns_name_encode");
    var b[64];
    var n = dns_encode_name("a.bc.def", &b);
    # 01 'a' 02 'bc' 03 'def' 00 → 10 bytes
    assert_eq(n, 10, "encoded length");
    assert_eq(load8(&b),     1,    "label 1 len");
    assert_eq(load8(&b + 1), 97,   "label 1 = 'a'");
    assert_eq(load8(&b + 2), 2,    "label 2 len");
    assert_eq(load8(&b + 5), 3,    "label 3 len");
    assert_eq(load8(&b + 9), 0,    "root terminator");

    # Reject empty label
    var b2[64];
    assert_eq(dns_encode_name("a..b", &b2), 0, "reject empty label");
    return 0;
}

# === DNS name decoder (no compression) ===
fn test_dns_name_decode_simple() {
    var dnl[8];
    test_group("dns_name_decode_simple");
    # Hand-craft a minimal DNS message containing the encoded name
    # at offset 12. Header bytes are zeroed.
    var msg[64];
    memset(&msg, 0, 64);
    # "example.com" at off 12: 07 'example' 03 'com' 00 = 13 bytes
    store8(&msg + 12, 7);
    store8(&msg + 13, 101); store8(&msg + 14, 120); store8(&msg + 15, 97);
    store8(&msg + 16, 109); store8(&msg + 17, 112); store8(&msg + 18, 108);
    store8(&msg + 19, 101);
    store8(&msg + 20, 3);
    store8(&msg + 21, 99); store8(&msg + 22, 111); store8(&msg + 23, 109);
    store8(&msg + 24, 0);

    var out[DNS_NAME_BUF_LEN];
    var next = dns_decode_name(&msg, 64, 12, &out, &dnl);
    assert_eq(next, 25, "next offset past name");
    assert_eq(load8(&out),     101, "decoded[0] = 'e'");
    assert_eq(load8(&out + 7), 46,  "decoded[7] = '.'");
    assert_eq(load8(&out + 8), 99,  "decoded[8] = 'c'");
    assert_eq(load8(&out + 11), 0,  "decoded NUL");
    return 0;
}

# === Name compression with pointer (legitimate, backward) ===
fn test_dns_name_decode_pointer() {
    var dnl[8];
    test_group("dns_name_decode_pointer");
    # Encode "com" at off 12 (4 bytes: 03 c o m 00).
    # Encode "www" + ptr-to-12 at off 17 (1+3 + 2 = 6 bytes).
    var msg[64];
    memset(&msg, 0, 64);
    store8(&msg + 12, 3);
    store8(&msg + 13, 99); store8(&msg + 14, 111); store8(&msg + 15, 109);
    store8(&msg + 16, 0);
    store8(&msg + 17, 3);
    store8(&msg + 18, 119); store8(&msg + 19, 119); store8(&msg + 20, 119);
    store8(&msg + 21, 0xC0);    # pointer high byte
    store8(&msg + 22, 12);      # offset 12

    var out[DNS_NAME_BUF_LEN];
    var next = dns_decode_name(&msg, 64, 17, &out, &dnl);
    assert_eq(next, 23, "next offset past pointer");
    # "www.com" = 119 119 119 46 99 111 109 0
    assert_eq(load8(&out),     119, "decoded[0] = 'w'");
    assert_eq(load8(&out + 3), 46,  "decoded[3] = '.'");
    assert_eq(load8(&out + 4), 99,  "decoded[4] = 'c'");
    assert_eq(load8(&out + 7), 0,   "decoded[7] = NUL");
    return 0;
}

# === Name compression CYCLE — SECURITY-CRITICAL ===
# A pointer pointing forward to itself (or back to itself) would
# loop forever. We require: pointer must aim BACKWARD, and we
# bound hops at NAME_DECODE_MAX_HOPS.
fn test_dns_name_decode_pointer_cycle() {
    var dnl[8];
    test_group("dns_name_decode_cycle");
    var msg[64];
    memset(&msg, 0, 64);
    # Pointer at off 12 pointing at offset 12 (itself).
    store8(&msg + 12, 0xC0);
    store8(&msg + 13, 12);

    var out[DNS_NAME_BUF_LEN];
    var next = dns_decode_name(&msg, 64, 12, &out, &dnl);
    assert_eq(next, 0, "self-pointer rejected (no hang, returns 0)");

    # Forward pointer (off 20 → off 30): must also be rejected since
    # RFC says pointers go backward only.
    memset(&msg, 0, 64);
    store8(&msg + 20, 0xC0);
    store8(&msg + 21, 30);
    var next2 = dns_decode_name(&msg, 64, 20, &out, &dnl);
    assert_eq(next2, 0, "forward pointer rejected");

    return 0;
}

# === Pointer offset out of bounds ===
fn test_dns_name_decode_pointer_oob() {
    var dnl[8];
    test_group("dns_name_decode_oob");
    var msg[32];
    memset(&msg, 0, 32);
    store8(&msg + 12, 0xC0);
    store8(&msg + 13, 200);    # offset 200 is past msg_len 32
    var out[DNS_NAME_BUF_LEN];
    var next = dns_decode_name(&msg, 32, 12, &out, &dnl);
    assert_eq(next, 0, "out-of-bounds pointer rejected");
    return 0;
}

# === Label too long ===
fn test_dns_name_decode_oversized_label() {
    var dnl[8];
    test_group("dns_name_decode_oversize");
    var msg[128];
    memset(&msg, 0, 128);
    store8(&msg + 12, 64);    # > 63 — but not a pointer (top bits clear)
    var out[DNS_NAME_BUF_LEN];
    var next = dns_decode_name(&msg, 128, 12, &out, &dnl);
    assert_eq(next, 0, "label > 63 rejected");
    return 0;
}

# === Header accessors ===
fn test_dns_header_accessors() {
    test_group("dns_header");
    var msg[12];
    store8(&msg,     0xAB); store8(&msg + 1, 0xCD);    # ID = 0xABCD
    store8(&msg + 2, 0x81); store8(&msg + 3, 0x83);    # flags = QR+RD+RA+NXDOMAIN
    store8(&msg + 4, 0x00); store8(&msg + 5, 0x01);
    store8(&msg + 6, 0x00); store8(&msg + 7, 0x05);
    store8(&msg + 8, 0x00); store8(&msg + 9, 0x02);
    store8(&msg + 10, 0x00); store8(&msg + 11, 0x07);

    assert_eq(dns_hdr_id(&msg),      0xABCD, "id");
    assert_eq(dns_hdr_flags(&msg),   0x8183, "flags");
    assert_eq(dns_hdr_qdcount(&msg), 1,      "qd");
    assert_eq(dns_hdr_ancount(&msg), 5,      "an");
    assert_eq(dns_hdr_nscount(&msg), 2,      "ns");
    assert_eq(dns_hdr_arcount(&msg), 7,      "ar");
    assert_eq(dns_hdr_rcode(&msg),   3,      "rcode = NXDOMAIN");
    return 0;
}

# === resolv.conf parsing ===
fn test_resolv() {
    test_group("resolv");
    var c1 = "nameserver 8.8.8.8\n";
    var a1 = resolv_parse(c1, strlen(c1));
    assert_eq(a1, 0x08080808, "single nameserver");

    var c2 = "# a comment\nnameserver 1.1.1.1\n";
    var a2 = resolv_parse(c2, strlen(c2));
    assert_eq(a2, 0x01010101, "comment then nameserver");

    var c3 = "search example.com\nnameserver 9.9.9.9\nnameserver 8.8.8.8\n";
    var a3 = resolv_parse(c3, strlen(c3));
    assert_eq(a3, 0x09090909, "first nameserver wins");

    var c4 = "# nothing\nsearch example.com\n";
    var a4 = resolv_parse(c4, strlen(c4));
    assert_eq(a4, 0, "no nameserver returns 0");

    var c5 = "nameserver 999.999.999.999\n";
    var a5 = resolv_parse(c5, strlen(c5));
    assert_eq(a5, 0, "bad IPv4 returns 0");

    return 0;
}

# === RR parsing: build a fake A-record response and parse it ===
fn test_dns_parse_a_response() {
    test_group("dns_parse_a");
    var msg[64];
    memset(&msg, 0, 64);
    # Header: id 0x1234, flags QR+RD+RA, qd=1, an=1
    store8(&msg,     0x12); store8(&msg + 1, 0x34);
    store8(&msg + 2, 0x81); store8(&msg + 3, 0x80);
    store8(&msg + 4, 0); store8(&msg + 5, 1);
    store8(&msg + 6, 0); store8(&msg + 7, 1);
    # Question at off 12: "a.com" + qtype A + qclass IN = 1+1 + 1+3 + 1 + 2 + 2 = 11
    store8(&msg + 12, 1); store8(&msg + 13, 97);
    store8(&msg + 14, 3); store8(&msg + 15, 99); store8(&msg + 16, 111); store8(&msg + 17, 109);
    store8(&msg + 18, 0);
    store8(&msg + 19, 0); store8(&msg + 20, 1);
    store8(&msg + 21, 0); store8(&msg + 22, 1);
    # Answer at off 23: pointer to off 12 + type A + class IN + ttl 300 + rdlen 4 + 1.2.3.4
    store8(&msg + 23, 0xC0); store8(&msg + 24, 12);    # ptr to "a.com"
    store8(&msg + 25, 0);    store8(&msg + 26, 1);     # type A
    store8(&msg + 27, 0);    store8(&msg + 28, 1);     # class IN
    store8(&msg + 29, 0); store8(&msg + 30, 0); store8(&msg + 31, 1); store8(&msg + 32, 44);    # ttl 300
    store8(&msg + 33, 0); store8(&msg + 34, 4);        # rdlen 4
    store8(&msg + 35, 1); store8(&msg + 36, 2); store8(&msg + 37, 3); store8(&msg + 38, 4);

    var start = dns_answer_section_start(&msg, 64);
    assert_eq(start, 23, "answer section starts after Q");
    var rr = alloc(DNS_RR_SIZE);
    var next = dns_parse_rr(&msg, 64, start, rr);
    assert_eq(next, 39, "parsed RR ends at off 39");
    assert_eq(dns_rr_type(rr),  1,   "rr type A");
    assert_eq(dns_rr_class(rr), 1,   "rr class IN");
    assert_eq(dns_rr_ttl(rr),   300, "rr ttl");
    assert_eq(dns_rr_rdata_off(rr), 35, "rr rdata offset");
    return 0;
}



# === RFC 1035 §5.1 presentation escaping (0.3.7) ===
#
# Labels and TXT character-strings are arbitrary octet runs on the wire. Before
# 0.3.7 they went to stdout raw, so a TXT record carrying CR + ESC [ 2 K erased
# the line dig had just printed and repainted a forged one — no spoofing needed,
# only a zone the attacker controls.
fn _esc_eq(src, n, esc_space, want, want_len, msg) {
    var eb[1024];
    var w = _esc_to_buf(&eb, 1024, src, n, esc_space);
    assert_eq(w, want_len, msg);
    var i = 0;
    var ok = 1;
    while (i < want_len) {
        if (load8(&eb + i) != load8(want + i)) { ok = 0; }
        i = i + 1;
    }
    assert_eq(ok, 1, msg);
    return 0;
}

fn test_output_escaping() {
    test_group("output_escaping");
    var b[16];

    # All-printable input must be byte-identical to before — no regression.
    _esc_eq("a.com", 5, 1, "a.com", 5, "printable passes through unchanged");

    # ESC (0x1B) — the terminal-control byte. \027 decimal, zero-padded to 3.
    store8(&b, 27);
    _esc_eq(&b, 1, 1, "\\027", 4, "ESC escapes to backslash-027");

    # CR (0x0D) — the carriage return that made the repaint attack work.
    store8(&b, 13);
    _esc_eq(&b, 1, 1, "\\013", 4, "CR escapes to backslash-013");

    # LF (0x0A) — forges an extra line in +short, which scripts word-split.
    store8(&b, 10);
    _esc_eq(&b, 1, 1, "\\010", 4, "LF escapes to backslash-010");

    # BEL (0x07) — proves the padding is three digits, not one.
    store8(&b, 7);
    _esc_eq(&b, 1, 1, "\\007", 4, "BEL zero-pads to three digits");

    # NUL — legal in a label (RFC 4343). The old strlen sink truncated the whole
    # name here, so `safe.com\0.evil.tld` displayed as `safe.com`.
    store8(&b, 97); store8(&b + 1, 0); store8(&b + 2, 98);
    _esc_eq(&b, 3, 1, "a\\000b", 6, "embedded NUL escapes, does not truncate");

    # Backslash doubles; quote escapes (a raw quote would break TXT delimiting).
    store8(&b, 92);
    _esc_eq(&b, 1, 1, "\\\\", 2, "backslash doubles");
    store8(&b, 34);
    _esc_eq(&b, 1, 0, "\\\"", 2, "quote escapes inside TXT");

    # High-bit / DEL.
    store8(&b, 255);
    _esc_eq(&b, 1, 1, "\\255", 4, "high-bit byte escapes");
    store8(&b, 127);
    _esc_eq(&b, 1, 1, "\\127", 4, "DEL escapes");

    # Space is context-dependent: escaped in an unquoted name, literal in TXT
    # where the quotes already delimit (BIND prints `v=spf1 -all`).
    store8(&b, 32);
    _esc_eq(&b, 1, 1, "\\032", 4, "space escapes in a name");
    _esc_eq(&b, 1, 0, " ", 1, "space stays literal inside TXT");

    # Refuses rather than truncating when the escape would not fit.
    var eb2[8];
    store8(&b, 27); store8(&b + 1, 27); store8(&b + 2, 27);
    assert_eq(_esc_to_buf(&eb2, 8, &b, 3, 1), 0 - 1, "over-long escape refused, not truncated");
    assert_eq(_esc_to_buf(&eb2, 8, &b, 2, 1), 8, "exactly-fitting escape accepted");
    return 0;
}

# === RFC 5452 §9.1 question matching (0.3.7 anti-spoof) ===
#
# Through 0.3.6 the ONLY reply checks were the 16-bit ID and the QR bit, so an
# off-path attacker who guessed the ID could return an answer for a DIFFERENT
# name and dig would print it. Every rejection below is a datagram that used to
# be accepted.
fn _tq_build(msg, qdcount, qtype, qclass) {
    # Header + question "a.com" at offset 12. Caller varies the tail fields.
    memset(msg, 0, 64);
    store8(msg + 4, 0); store8(msg + 5, qdcount);
    store8(msg + 12, 1); store8(msg + 13, 97);                     # "a"
    store8(msg + 14, 3); store8(msg + 15, 99);
    store8(msg + 16, 111); store8(msg + 17, 109);                  # "com"
    store8(msg + 18, 0);                                           # root
    store8(msg + 19, (qtype >> 8) & 0xFF);  store8(msg + 20, qtype & 0xFF);
    store8(msg + 21, (qclass >> 8) & 0xFF); store8(msg + 22, qclass & 0xFF);
    return 23;
}

fn test_dns_question_match() {
    test_group("dns_question_match");
    var msg[64];

    var n = _tq_build(&msg, 1, DNS_TYPE_A, DNS_CLASS_IN);
    assert_eq(dns_question_matches(&msg, n, "a.com", DNS_TYPE_A), 1, "question matches");

    # Case folding — RFC 4343, and 0x20-encoding resolvers randomize case.
    assert_eq(dns_question_matches(&msg, n, "A.CoM", DNS_TYPE_A), 1, "question match is case-insensitive");

    # The attack this closes: right ID, wrong name.
    assert_eq(dns_question_matches(&msg, n, "b.com", DNS_TYPE_A), 0, "different name rejected");
    assert_eq(dns_question_matches(&msg, n, "a.net", DNS_TYPE_A), 0, "different TLD rejected");
    assert_eq(dns_question_matches(&msg, n, "aa.com", DNS_TYPE_A), 0, "longer label rejected");
    assert_eq(dns_question_matches(&msg, n, "a.co", DNS_TYPE_A),  0, "shorter label rejected");

    # Right name, wrong type.
    assert_eq(dns_question_matches(&msg, n, "a.com", DNS_TYPE_AAAA), 0, "different qtype rejected");

    # Wrong class.
    var m2[64];
    var n2 = _tq_build(&m2, 1, DNS_TYPE_A, 3);
    assert_eq(dns_question_matches(&m2, n2, "a.com", DNS_TYPE_A), 0, "non-IN class rejected");

    # qdcount must be exactly 1 — 0 means there is nothing to compare against,
    # and >1 lets an attacker append a matching question after a bogus one.
    var m3[64];
    var n3 = _tq_build(&m3, 0, DNS_TYPE_A, DNS_CLASS_IN);
    assert_eq(dns_question_matches(&m3, n3, "a.com", DNS_TYPE_A), 0, "qdcount 0 rejected");
    var m4[64];
    var n4 = _tq_build(&m4, 2, DNS_TYPE_A, DNS_CLASS_IN);
    assert_eq(dns_question_matches(&m4, n4, "a.com", DNS_TYPE_A), 0, "qdcount 2 rejected");

    # A question that runs past the received length must not be read.
    assert_eq(dns_question_matches(&msg, 18, "a.com", DNS_TYPE_A), 0, "truncated question rejected");
    assert_eq(dns_question_matches(&msg, 12, "a.com", DNS_TYPE_A), 0, "header-only reply rejected");
    return 0;
}

# === CLI bounds (0.3.7 hardening) ===
fn test_cli_bounds() {
    test_group("cli_bounds");
    var av[64];
    store64(&av, "dig");
    store64(&av + 16, "example.com");

    # +timeout=0 reached SO_RCVTIMEO as {0,0} through 0.3.6, which Linux reads
    # as "block indefinitely" — `dig +timeout=0` hung forever. Clamped, not
    # rejected, matching BIND.
    var r1 = dig_cli_new();
    store64(&av + 8, "+timeout=0");
    assert_eq(dig_cli_parse_argv(r1, 3, &av), DIG_CLI_OK, "+timeout=0 parses");
    assert_eq(dig_cli_timeout_s(r1), DIG_MIN_TIMEOUT_S, "+timeout=0 clamps up to 1s");

    # Upper clamp keeps query.cyr's `t0 + timeout_s * 1000000` from overflowing.
    var r2 = dig_cli_new();
    store64(&av + 8, "+timeout=999999");
    assert_eq(dig_cli_parse_argv(r2, 3, &av), DIG_CLI_OK, "huge +timeout parses");
    assert_eq(dig_cli_timeout_s(r2), DIG_MAX_TIMEOUT_S, "huge +timeout clamps down");

    var r3 = dig_cli_new();
    store64(&av + 8, "+retry=0");
    assert_eq(dig_cli_parse_argv(r3, 3, &av), DIG_CLI_OK, "+retry=0 parses");
    assert_eq(dig_cli_retry(r3), DIG_MIN_RETRY, "+retry=0 clamps up to 1 attempt");

    var r4 = dig_cli_new();
    store64(&av + 8, "+retry=100000");
    assert_eq(dig_cli_parse_argv(r4, 3, &av), DIG_CLI_OK, "huge +retry parses");
    assert_eq(dig_cli_retry(r4), DIG_MAX_RETRY, "huge +retry clamps down");

    # In range, values pass through untouched.
    var r5 = dig_cli_new();
    store64(&av + 8, "+timeout=7");
    assert_eq(dig_cli_parse_argv(r5, 3, &av), DIG_CLI_OK, "+timeout=7 parses");
    assert_eq(dig_cli_timeout_s(r5), 7, "in-range +timeout preserved");

    # Signed overflow wraps, so the old `if (v < 0)` guard alone let a long
    # enough digit run land back on a positive value. The digit cap makes the
    # check total.
    var r6 = dig_cli_new();
    store64(&av + 8, "+timeout=99999999999999999999");
    assert_eq(dig_cli_parse_argv(r6, 3, &av), DIG_CLI_ERR_PARSE, "over-long digit run rejected");

    var r7 = dig_cli_new();
    store64(&av + 8, "+timeout=abc");
    assert_eq(dig_cli_parse_argv(r7, 3, &av), DIG_CLI_ERR_PARSE, "non-numeric +timeout rejected");

    var r8 = dig_cli_new();
    store64(&av + 8, "+timeout");
    assert_eq(dig_cli_parse_argv(r8, 3, &av), DIG_CLI_ERR_PARSE, "+timeout without = rejected");
    return 0;
}

# === Unknown record type is an error, not a silent fallback (0.3.7) ===
fn test_cli_bad_type() {
    test_group("cli_bad_type");
    var av[64];
    store64(&av, "dig");
    store64(&av + 8, "example.com");

    # Through 0.3.6 a second bare token was silently DISCARDED: `dig example.com
    # BOGUSTYPE` quietly queried A and exited 0, answering a different question
    # than the one asked with nothing on stderr.
    var r1 = dig_cli_new();
    store64(&av + 16, "BOGUSTYPE");
    assert_eq(dig_cli_parse_argv(r1, 3, &av), DIG_CLI_ERR_BAD_TYPE, "unknown type is an error");

    # Recognized types still work, and are case-insensitive.
    var r2 = dig_cli_new();
    store64(&av + 16, "MX");
    assert_eq(dig_cli_parse_argv(r2, 3, &av), DIG_CLI_OK, "MX accepted");
    assert_eq(dig_cli_qtype(r2), DNS_TYPE_MX, "MX sets qtype");

    var r3 = dig_cli_new();
    store64(&av + 16, "aaaa");
    assert_eq(dig_cli_parse_argv(r3, 3, &av), DIG_CLI_OK, "lowercase aaaa accepted");
    assert_eq(dig_cli_qtype(r3), DNS_TYPE_AAAA, "aaaa sets qtype");

    # No type token at all still defaults to A.
    var r4 = dig_cli_new();
    assert_eq(dig_cli_parse_argv(r4, 2, &av), DIG_CLI_OK, "name only accepted");
    assert_eq(dig_cli_qtype(r4), DNS_TYPE_A, "qtype defaults to A");
    return 0;
}


# === Guards that survived deletion before 0.3.8 (E2) ===
#
# Every assertion in this group corresponds to a guard that could be deleted
# with the whole suite still reporting green. They are the ones that were
# protecting nothing.
fn test_surviving_guards() {
    test_group("surviving_guards");
    var msg[256];
    var rr = alloc(DNS_RR_SIZE);

    # -- dns_parse_rr's rdlength bound --
    # A record claiming more rdata than the message holds must be refused.
    memset(&msg, 0, 256);
    store8(&msg + 12, 0);                                   # root owner name
    store8(&msg + 14, 1); store8(&msg + 16, 1);             # type A, class IN
    store8(&msg + 21, 0xFF); store8(&msg + 22, 0xFF);       # rdlength 65535
    assert_eq(dns_parse_rr(&msg, 40, 12, rr), 0, "rdlength 65535 refused");

    store8(&msg + 21, 0); store8(&msg + 22, 4);             # rdlength 4
    assert_eq(dns_parse_rr(&msg, 27, 12, rr), 27, "rdlength that exactly fits is accepted");
    assert_eq(dns_parse_rr(&msg, 26, 12, rr), 0,  "rdlength one past msg_len refused");
    store8(&msg + 22, 0);                                   # rdlength 0
    assert_eq(dns_parse_rr(&msg, 40, 12, rr), 23, "rdlength 0 advances past the header");

    # -- NAME_DECODE_MAX_HOPS --
    # The existing cycle group feeds a self-pointer and a forward pointer, both
    # killed by the must-point-backward rule alone, so the hop BUDGET was never
    # the deciding guard. This is a chain of strictly-backward 2-byte pointers
    # where every single hop is legal — only the counter can stop it.
    memset(&msg, 0, 256);
    store8(&msg + 4, 0);                                    # a root label at 4
    var q = 6;
    var prev = 4;
    while (q < 160) {
        store8(&msg + q, 0xC0); store8(&msg + q + 1, prev); # -> strictly backward
        prev = q;
        q = q + 2;
    }
    var ob[DNS_NAME_BUF_LEN];
    var obl[8];
    assert_eq(dns_decode_name(&msg, 256, prev, &ob, &obl), 0, "long legal backward chain hits the hop budget");
    assert_eq(dns_skip_name(&msg, 256, prev), 0, "skip_name hits the hop budget too");

    # -- dns_skip_name's label>63 guard --
    # The obvious test passes for the wrong reason: in a small buffer an
    # oversize skip runs past msg_len and the LENGTH check catches it. Here the
    # skip lands back in bounds, so only the label guard can refuse it.
    memset(&msg, 0, 256);
    store8(&msg + 12, 64);                                  # illegal label length
    store8(&msg + 77, 0);                                   # terminator, in bounds
    assert_eq(dns_skip_name(&msg, 256, 12), 0, "skip_name refuses a 64-byte label in bounds");
    store8(&msg + 12, 63);
    store8(&msg + 76, 0);
    assert_eq(dns_skip_name(&msg, 256, 12), 77, "skip_name accepts a 63-byte label");

    # -- dns_skip_name's total-length cap (added 0.3.8) --
    # Six 63-byte labels = 384 wire octets, over RFC 1035 §2.3.4's 255. The
    # walker used to accept this while the decoder refused it, so full output
    # printed `;; ANSWER` with no records under it and exit 0 while `+short` on
    # the same bytes printed the address.
    # The buffer must be big enough that the over-long name still FITS —
    # otherwise the msg_len bound refuses it and the test passes without the
    # wire cap ever running. 4 x 63-byte labels = 256 wire octets (each label
    # costs its length byte too), one over RFC 1035 §2.3.4's 255.
    var big[512];
    memset(&big, 0, 512);
    var o = 12;
    var lab = 0;
    while (lab < 4) {
        store8(&big + o, 63);
        o = o + 64;
        lab = lab + 1;
    }
    store8(&big + o, 0);
    assert_eq(dns_skip_name(&big, 512, 12), 0, "skip_name refuses a name over 255 wire octets");
    # Positive control at 3 labels = 192 wire octets, comfortably legal — so a
    # mutant cannot satisfy both by simply refusing everything.
    memset(&big, 0, 512);
    o = 12;
    lab = 0;
    while (lab < 3) {
        store8(&big + o, 63);
        o = o + 64;
        lab = lab + 1;
    }
    store8(&big + o, 0);
    assert_eq(dns_skip_name(&big, 512, 12), o + 1, "skip_name accepts a 192-octet name");
    var db[DNS_NAME_BUF_LEN];
    var dbl[8];
    assert_eq(dns_decode_name(&big, 512, 12, &db, &dbl), o + 1, "decode_name agrees with skip_name");

    # The one window where decode_name's WIRE cap differs from the presentation
    # cap it already had. Labels 63/63/63/62 are 256 wire octets (one over the
    # RFC limit) but only 254 presentation characters — so the old `dst >= 255`
    # check accepted them and the name was two octets over. Without this case
    # the wire cap in decode_name is untested, since every longer name is caught
    # by the presentation check anyway.
    memset(&big, 0, 512);
    store8(&big + 12, 63);
    store8(&big + 76, 63);
    store8(&big + 140, 63);
    store8(&big + 204, 62);
    store8(&big + 267, 0);
    assert_eq(dns_decode_name(&big, 512, 12, &db, &dbl), 0, "decode_name refuses a 256-octet wire name");
    assert_eq(dns_skip_name(&big, 512, 12), 0, "skip_name refuses it too — the two agree");

    # -- dns_skip_question's p + 4 bound --
    memset(&msg, 0, 256);
    store8(&msg + 4, 0); store8(&msg + 5, 1);               # qdcount 1
    store8(&msg + 12, 0);                                   # root question name
    assert_eq(dns_answer_section_start(&msg, 17), 17, "question with a full fixed tail is accepted");
    assert_eq(dns_answer_section_start(&msg, 16), 0,  "question truncated in its qtype/qclass refused");
    return 0;
}

# === resolv.conf parsing (E2 + the 0.3.8 repairs) ===
fn test_resolv_038() {
    test_group("resolv_038");

    # The whitespace guard after the literal. The natural test
    # (`nameservers 1.2.3.4`) passes for the wrong reason — it extracts "s",
    # which ipv4_parse rejects anyway. This is the discriminating input.
    var c1 = "nameserver1.2.3.4\n";
    assert_eq(resolv_parse(c1, 18), 0, "nameserver with no separator is not a nameserver line");

    # 0 is resolv_parse's not-found sentinel, so a `0.0.0.0` line must be
    # SKIPPED, not returned. Two lines are required: a single-line case cannot
    # tell "skipped and kept scanning" from "aborted the scan".
    var c2 = "nameserver 0.0.0.0\nnameserver 192.168.1.1\n";
    assert_eq(resolv_parse(c2, 42), 0xC0A80101, "0.0.0.0 is skipped, scan continues");

    # CRLF. Without the CR break the token is "1.1.1.1\r", which ipv4_parse
    # rejects, and discovery silently fell through to 8.8.8.8.
    var c3 = "nameserver 1.1.1.1\r\n";
    assert_eq(resolv_parse(c3, 20), 0x01010101, "CRLF line parses");
    var c4 = "# comment\r\nnameserver 9.9.9.9\r\nnameserver 1.1.1.1\r\n";
    assert_eq(resolv_parse(c4, 50), 0x09090909, "multi-line CRLF advances correctly");

    # A truncated buffer must not yield a DIFFERENT valid address.
    var c5 = "nameserver 10.0.0.53\n";
    assert_eq(resolv_parse(c5, 21), 0x0A000035, "full line parses");
    # The 4096-byte read cut mid-octet: 10.0.0.53 becomes a perfectly valid
    # 10.0.0.5 and nothing anywhere reports a problem. This is why the buffer
    # grew to 16 KiB at 0.3.8 rather than the parser learning to detect it —
    # the parser CANNOT detect it, the bytes it was handed are well-formed.
    assert_eq(resolv_parse(c5, 19), 0x0A000005, "mid-octet cut silently yields a different valid address");
    return 0;
}

# === Reply acceptance policy (E4) ===
#
# dns_question_matches was well covered as a function; its USE was not covered
# at all, so every guard in the accept path could be deleted with a green suite.
fn test_reply_acceptable() {
    test_group("reply_acceptable");
    var msg[64];
    var n = _tq_build(&msg, 1, DNS_TYPE_A, DNS_CLASS_IN);
    store8(&msg, 0x12); store8(&msg + 1, 0x34);             # id 0x1234
    store8(&msg + 2, 0x80);                                 # QR set

    assert_eq(query_reply_acceptable(&msg, n, 0x1234, "a.com", DNS_TYPE_A), 1, "good reply accepted");
    assert_eq(query_reply_acceptable(&msg, n, 0x1235, "a.com", DNS_TYPE_A), 0, "wrong id rejected");
    assert_eq(query_reply_acceptable(&msg, n, 0x1234, "b.com", DNS_TYPE_A), 0, "wrong name rejected");
    assert_eq(query_reply_acceptable(&msg, n, 0x1234, "a.com", DNS_TYPE_MX), 0, "wrong qtype rejected");
    assert_eq(query_reply_acceptable(&msg, 11, 0x1234, "a.com", DNS_TYPE_A), 0, "runt rejected");
    store8(&msg + 2, 0);                                    # clear QR
    assert_eq(query_reply_acceptable(&msg, n, 0x1234, "a.com", DNS_TYPE_A), 0, "QR-clear rejected");
    return 0;
}


# === AAAA rendering, RFC 5952 (E3) ===
#
# Through 0.3.7 this printed eight fixed 4-hex-digit groups, so EVERY
# real-world AAAA differed from BIND — not merely ones with zero runs. Each
# expectation below was cross-checked against glibc inet_ntop, which is the
# exact primitive BIND uses.
fn _aaaa_is(bytes, want, msg) {
    var raw[16];
    var i = 0;
    while (i < 16) { store8(&raw + i, load8(bytes + i)); i = i + 1; }
    var out[64];
    var n = _aaaa_to_buf(&out, &raw, 0);
    assert_eq(n, strlen(want), msg);
    var ok = 1;
    var k = 0;
    while (k < n) {
        if (load8(&out + k) != load8(want + k)) { ok = 0; }
        k = k + 1;
    }
    assert_eq(ok, 1, msg);
    return 0;
}

fn _aaaa_set(b, i, hi, lo) {
    store8(b + i * 2, hi);
    store8(b + i * 2 + 1, lo);
    return 0;
}

fn test_aaaa_rfc5952() {
    test_group("aaaa_rfc5952");
    var b[16];

    # All zeros -> "::" (§4.2.2: a run of 8 collapses entirely)
    memset(&b, 0, 16);
    _aaaa_is(&b, "::", "all zeros renders ::");

    # ::1 — the trailing-run case, where the closing colon must be emitted
    memset(&b, 0, 16);
    _aaaa_set(&b, 7, 0, 1);
    _aaaa_is(&b, "::1", "loopback renders ::1");

    # 2001:db8::1 — leading-zero suppression (§4.1) plus a middle run
    memset(&b, 0, 16);
    _aaaa_set(&b, 0, 0x20, 0x01); _aaaa_set(&b, 1, 0x0d, 0xb8); _aaaa_set(&b, 7, 0, 1);
    _aaaa_is(&b, "2001:db8::1", "2001:db8::1");

    # §4.2.3 tie-break: two runs of 2, the LEFTMOST wins.
    # 2001:db8:0:0:1:0:0:1 -> 2001:db8::1:0:0:1
    memset(&b, 0, 16);
    _aaaa_set(&b, 0, 0x20, 0x01); _aaaa_set(&b, 1, 0x0d, 0xb8);
    _aaaa_set(&b, 4, 0, 1); _aaaa_set(&b, 7, 0, 1);
    _aaaa_is(&b, "2001:db8::1:0:0:1", "equal-length runs: leftmost wins");

    # No zero run at all — isolates §4.1 leading-zero suppression, which is the
    # part that made every ordinary address differ from BIND.
    memset(&b, 0, 16);
    var i = 0;
    while (i < 8) { _aaaa_set(&b, i, 0, i + 1); i = i + 1; }
    _aaaa_is(&b, "1:2:3:4:5:6:7:8", "no zero run, leading zeros suppressed");

    # §4.2.2: a SINGLE zero field must NOT be shortened to ::
    memset(&b, 0, 16);
    i = 0;
    while (i < 8) { _aaaa_set(&b, i, 0, i + 1); i = i + 1; }
    _aaaa_set(&b, 3, 0, 0);
    _aaaa_is(&b, "1:2:3:0:5:6:7:8", "a lone zero field is not collapsed");

    # §5 / glibc inet_ntop6: IPv4-mapped renders a dotted quad
    memset(&b, 0, 16);
    _aaaa_set(&b, 5, 0xFF, 0xFF); _aaaa_set(&b, 6, 0xC0, 0x00); _aaaa_set(&b, 7, 0x02, 0x01);
    _aaaa_is(&b, "::ffff:192.0.2.1", "IPv4-mapped renders dotted quad");

    # ::0.0.0.1 is NOT taken as v4 (glibc excludes best.len==7 with words[7]==1)
    memset(&b, 0, 16);
    _aaaa_set(&b, 7, 0, 1);
    _aaaa_is(&b, "::1", "the len-7 words[7]==1 case stays ::1, not ::0.0.0.1");
    return 0;
}

# === rdata validation returns (E3 / A3 / A4) ===
#
# Every one of these used to print a half-rendered record and return a status
# nobody read. The assertions are on the RETURN VALUE, which is what main.cyr
# now folds into the exit code.
fn _rr_at(msg, off, t, rdlen) {
    # Minimal RR: root owner name, type t, class IN, ttl 0, rdlength rdlen.
    store8(msg + off, 0);
    store8(msg + off + 1, (t >> 8) & 0xFF);  store8(msg + off + 2, t & 0xFF);
    store8(msg + off + 3, 0);                store8(msg + off + 4, 1);
    store8(msg + off + 9, (rdlen >> 8) & 0xFF); store8(msg + off + 10, rdlen & 0xFF);
    return off + 11;
}

fn test_rdata_validation() {
    test_group("rdata_validation");
    var msg[256];
    var rr = alloc(DNS_RR_SIZE);

    # A: rdlength must be exactly 4.
    var lens = 0;
    while (lens < 8) {
        memset(&msg, 0, 256);
        var rdo = _rr_at(&msg, 12, DNS_TYPE_A, lens);
        var nx = dns_parse_rr(&msg, 256, 12, rr);
        if (lens != 4) {
            assert_eq(output_print_rdata(&msg, 256, rr, nx), 0 - 1, "A with wrong rdlength refused");
        }
        lens = lens + 1;
    }

    # AAAA: exactly 16.
    memset(&msg, 0, 256);
    var rdo2 = _rr_at(&msg, 12, DNS_TYPE_AAAA, 15);
    var nx2 = dns_parse_rr(&msg, 256, 12, rr);
    assert_eq(output_print_rdata(&msg, 256, rr, nx2), 0 - 1, "AAAA rdlength 15 refused");

    # MX below its fixed size.
    memset(&msg, 0, 256);
    _rr_at(&msg, 12, DNS_TYPE_MX, 2);
    var nx3 = dns_parse_rr(&msg, 256, 12, rr);
    assert_eq(output_print_rdata(&msg, 256, rr, nx3), 0 - 1, "MX rdlength 2 refused");

    # SRV below its fixed size.
    memset(&msg, 0, 256);
    _rr_at(&msg, 12, DNS_TYPE_SRV, 6);
    var nx4 = dns_parse_rr(&msg, 256, 12, rr);
    assert_eq(output_print_rdata(&msg, 256, rr, nx4), 0 - 1, "SRV rdlength 6 refused");

    # A TXT whose internal length prefix overruns its own rdata.
    memset(&msg, 0, 256);
    var rdo5 = _rr_at(&msg, 12, DNS_TYPE_TXT, 3);
    store8(&msg + rdo5, 9);                       # claims 9 bytes inside a 3-byte rdata
    var nx5 = dns_parse_rr(&msg, 256, 12, rr);
    assert_eq(output_print_rdata(&msg, 256, rr, nx5), 0 - 1, "TXT inner length overrunning rdata refused");

    # THE A4 CASE. rdlen=0 for a name-bearing type: memory-safe, but the name
    # would be read out of the NEXT record's bytes and printed as this record's
    # authoritative content, returning success.
    var t = 0;
    var types[3];
    memset(&msg, 0, 256);
    var rdo6 = _rr_at(&msg, 12, DNS_TYPE_NS, 0);
    store8(&msg + rdo6, 3);                       # a neighbouring name follows
    store8(&msg + rdo6 + 1, 101); store8(&msg + rdo6 + 2, 118); store8(&msg + rdo6 + 3, 108);
    store8(&msg + rdo6 + 4, 0);
    var nx6 = dns_parse_rr(&msg, 256, 12, rr);
    assert_eq(output_print_rdata(&msg, 256, rr, nx6), 0 - 1, "NS rdlength 0 refused, not read from the next record");

    # Positive control: a legal uncompressed CNAME whose name exactly fills rdata.
    memset(&msg, 0, 256);
    var rdo7 = _rr_at(&msg, 12, DNS_TYPE_CNAME, 5);
    store8(&msg + rdo7, 1); store8(&msg + rdo7 + 1, 97);   # "a"
    store8(&msg + rdo7 + 2, 1); store8(&msg + rdo7 + 3, 98); # "b"
    store8(&msg + rdo7 + 4, 0);
    var nx7 = dns_parse_rr(&msg, 256, 12, rr);
    assert_eq(output_print_rdata(&msg, 256, rr, nx7), 0, "legal CNAME exactly filling rdata is accepted");
    return 0;
}

# === RCODE and CLASS naming (E3 / A8 / A10) ===
fn test_rcode_names() {
    test_group("rcode_names");
    assert_eq(strlen(output_rcode_str(0)), 7, "NOERROR");
    assert_eq(strlen(output_rcode_str(3)), 8, "NXDOMAIN");
    assert_eq(strlen(output_rcode_str(5)), 7, "REFUSED");
    # 6-10 gained mnemonics at 0.3.8; every one of them used to print `RCODE?`.
    assert_eq(strlen(output_rcode_str(6)),  8, "YXDOMAIN");
    assert_eq(strlen(output_rcode_str(7)),  7, "YXRRSET");
    assert_eq(strlen(output_rcode_str(8)),  7, "NXRRSET");
    assert_eq(strlen(output_rcode_str(9)),  7, "NOTAUTH");
    assert_eq(strlen(output_rcode_str(10)), 7, "NOTZONE");
    # 11-15 have no mnemonic; the accessor returns 0 so the printer can format
    # RESERVED<n> rather than discarding the value in a flat "RCODE?".
    assert_eq(output_rcode_str(11), 0, "reserved rcode has no mnemonic");
    assert_eq(output_rcode_str(15), 0, "reserved rcode 15 has no mnemonic");
    # Types: recognized ones resolve, unknown returns 0 so TYPE<n> can be built.
    assert_eq(strlen(output_type_str(DNS_TYPE_A)), 1, "type A");
    assert_eq(strlen(output_type_str(DNS_TYPE_AAAA)), 4, "type AAAA");
    assert_eq(output_type_str(257), 0, "unknown type has no mnemonic");
    return 0;
}

# === Truncated response (TC=1) detection ===
fn test_dns_truncated() {
    test_group("dns_truncated");
    var msg[12];
    memset(&msg, 0, 12);
    store8(&msg + 2, 0x83); store8(&msg + 3, 0x80);    # TC=1, QR=1, RD=1, RA=1
    assert_eq(dns_hdr_truncated(&msg), 1, "TC bit detected");

    var msg2[12];
    memset(&msg2, 0, 12);
    store8(&msg2 + 2, 0x81); store8(&msg2 + 3, 0x80);    # TC=0
    assert_eq(dns_hdr_truncated(&msg2), 0, "TC bit absent");
    return 0;
}

fn main() {
    alloc_init();
    test_name_buf_contract();
    test_ipv4();
    test_dns_query_build();
    test_dns_name_encode();
    test_dns_name_decode_simple();
    test_dns_name_decode_pointer();
    test_dns_name_decode_pointer_cycle();
    test_dns_name_decode_pointer_oob();
    test_dns_name_decode_oversized_label();
    test_dns_header_accessors();
    test_resolv();
    test_dns_parse_a_response();
    test_dns_truncated();
    test_aaaa_rfc5952();
    test_rdata_validation();
    test_rcode_names();
    test_surviving_guards();
    test_resolv_038();
    test_reply_acceptable();
    test_output_escaping();
    test_dns_question_match();
    test_cli_bounds();
    test_cli_bad_type();
    return assert_summary();
}

var exit_code = main();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a
# wait status is only 8 bits — an unclamped 256 / 512 / 768 failures would exit
# 0 and score PASS. Any failure at all is exit 1.
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
